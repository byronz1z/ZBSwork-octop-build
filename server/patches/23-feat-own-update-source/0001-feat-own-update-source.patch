--- /dev/null
+++ b/dashboard/src/components/zbs/ZbsVersionBadge.tsx
@@ -0,0 +1,33 @@
+// 版本徽标：直接显示后端给的显示版本号（ZBS 段或官方版本），无更新红点。
+
+import { Tooltip } from "antd";
+import { useTranslation } from "react-i18next";
+
+import { useUpdateStatus } from "../../hooks/useUpdateStatus";
+import { zbsDisplayVersion } from "./constants";
+import styles from "../CurrentVersionBadge/index.module.less";
+
+interface ZbsVersionBadgeProps {
+  isMobile?: boolean;
+}
+
+export default function ZbsVersionBadge({ isMobile }: ZbsVersionBadgeProps) {
+  const { status } = useUpdateStatus();
+  const { t } = useTranslation();
+
+  const version = zbsDisplayVersion(status?.current_version);
+  if (!version) return null;
+
+  return (
+    <Tooltip title={t("zbsUpdate.versionTooltip", { version })} mouseEnterDelay={0.35}>
+      <span
+        className={`${styles.versionBadge} ${
+          isMobile ? styles.versionBadgeMobile : ""
+        }`}
+        aria-label={t("zbsUpdate.versionTooltip", { version })}
+      >
+        {version}
+      </span>
+    </Tooltip>
+  );
+}
