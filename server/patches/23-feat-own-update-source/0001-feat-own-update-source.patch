diff --git a/src/octop/infra/setup/zbs_version.py b/src/octop/infra/setup/zbs_version.py
new file mode 100644
index 0000000000000000000000000000000000000000..ccb40ca6f95a4fd06c061445a5ea8ff933411dfa
--- /dev/null
+++ b/src/octop/infra/setup/zbs_version.py
@@ -0,0 +1,88 @@
+"""ZBS build version display (patch 23).
+
+The image build pipeline stamps the full version (``<official>-zbs<ours>``,
+e.g. ``1.0.2b6-zbs0.3``) into ``src/octop/zbs_version.txt``. The web UI shows
+only our segment (``ZBS0.3``); when the file is absent (local development,
+plain pip install) the official package version is shown instead.
+"""
+
+from __future__ import annotations
+
+import time
+from collections.abc import Callable
+from pathlib import Path
+
+# src/octop/zbs_version.txt — two parents up from infra/setup/.
+_ZBS_VERSION_FILE = Path(__file__).resolve().parents[2] / "zbs_version.txt"
+_ZBS_MARKER = "-zbs"
+
+
+def read_zbs_version() -> str | None:
+    """Return our version segment (e.g. ``0.3``), or None when not stamped."""
+    try:
+        text = _ZBS_VERSION_FILE.read_text(encoding="utf-8").strip()
+    except OSError:
+        return None
+    idx = text.lower().rfind(_ZBS_MARKER)
+    if idx < 0:
+        return None
+    segment = text[idx + len(_ZBS_MARKER) :].strip()
+    return segment or None
+
+
+def display_version() -> str:
+    """Return the version label for the web UI.
+
+    ``ZBS0.3`` when the build stamped ``zbs_version.txt``; otherwise the
+    official installed package version (local development).
+    """
+    segment = read_zbs_version()
+    if segment:
+        return f"ZBS{segment}"
+    from octop.infra.setup.self_update import get_local_version
+
+    return get_local_version()
+
+
+def zbs_status(
+    *,
+    stable_only: bool,
+    detect_service_mode: Callable[[], object],
+    is_desktop_process: Callable[[], bool],
+    is_editable: bool,
+) -> dict[str, object]:
+    """Status payload for the web UI: our version, never an update.
+
+    ZBS builds ship as new images; the web update endpoints return the
+    current version and "no update" without touching PyPI. The callers pass
+    in the official helpers (service mode / desktop / editable detection) so
+    this module owns only the ZBS policy, not the probes.
+    """
+    return {
+        "current_version": display_version(),
+        "latest_version": None,
+        "latest_any": None,
+        "latest_stable": None,
+        "description": None,
+        "has_update": False,
+        "is_editable": is_editable,
+        "service_mode": detect_service_mode(),
+        "desktop": is_desktop_process(),
+        "error": None,
+        "error_code": None,
+        "source": None,
+        "last_check_time": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
+        "release_notes": None,
+        "stable_only": stable_only,
+        "latest_is_prerelease": False,
+    }
+
+
+def reject_web_upgrade() -> None:
+    """Raise FORBIDDEN: ZBS builds update by deploying a new image, not PyPI."""
+    from octop.infra.errors import ErrorCode, OctopError
+
+    raise OctopError(
+        ErrorCode.FORBIDDEN,
+        "this ZBS build updates by deploying a new image, not from PyPI",
+    )
