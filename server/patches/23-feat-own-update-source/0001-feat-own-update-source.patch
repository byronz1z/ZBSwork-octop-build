diff --git a/dashboard/src/components/zbs/ZbsUpdateConfig.tsx b/dashboard/src/components/zbs/ZbsUpdateConfig.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..099366463d794568e105be2e0c6dac783ea4dbe5
--- /dev/null
+++ b/dashboard/src/components/zbs/ZbsUpdateConfig.tsx
@@ -0,0 +1,87 @@
+// 补丁 23：更新页的 ZBS 实现——只显示当前版本号 + 重启服务。
+// 官方 UpdateConfig.tsx 只在页面入口挂载本组件，官方实现保留不删。
+
+import { useCallback, useEffect, useState } from "react";
+import { useTranslation } from "react-i18next";
+import { Power, RefreshCw, Sparkles } from "lucide-react";
+import { updateApi, type UpdateStatus } from "../../api/modules/update";
+import { useServiceRestartContext } from "../../context/ServiceRestartContext";
+import { storeUpdateStatus } from "../../utils/updateStatusCache";
+import { zbsDisplayVersion } from "./constants";
+import styles from "../../pages/Settings/AdvancedSettings/UpdateConfig.module.less";
+import { TabPanelHeader } from "../../pages/Settings/AdvancedSettings/TabPanelHeader";
+
+export default function ZbsUpdateConfig() {
+  const { t } = useTranslation();
+  const [status, setStatus] = useState<UpdateStatus | null>(null);
+  const { restartPhase, isRestarting, requestRestart } =
+    useServiceRestartContext();
+
+  useEffect(() => {
+    updateApi
+      .getUpdateStatus()
+      .then((next) => {
+        storeUpdateStatus(next);
+        setStatus(next);
+      })
+      .catch(() => {});
+  }, []);
+
+  const handleRestart = useCallback(() => {
+    requestRestart();
+  }, [requestRestart]);
+
+  const isServiceMode = !!status?.service_mode;
+  const restartUiLocked = restartPhase !== "idle" && restartPhase !== "timeout";
+  const version = zbsDisplayVersion(status?.current_version);
+
+  return (
+    <div className={styles.container}>
+      <TabPanelHeader
+        icon={<RefreshCw size={22} />}
+        title={t("zbsUpdate.title")}
+        description={t("zbsUpdate.description")}
+      />
+
+      <div className={styles.layout}>
+        <section
+          className={styles.panel}
+          aria-label={t("zbsUpdate.panelTitle")}
+        >
+          <div className={styles.panelTitleRow}>
+            <span className={styles.panelTitleIcon}>
+              <Sparkles size={16} />
+            </span>
+            <h3 className={styles.panelTitle}>{t("zbsUpdate.panelTitle")}</h3>
+          </div>
+          <p className={styles.panelDesc}>{t("zbsUpdate.panelDesc")}</p>
+
+          <div className={styles.versionGrid}>
+            <div className={styles.versionCard}>
+              <span className={styles.versionLabel}>
+                {t("zbsUpdate.currentVersion")}
+              </span>
+              <span className={styles.versionValue}>{version ?? "—"}</span>
+            </div>
+          </div>
+
+          {isServiceMode && (
+            <div className={styles.actions}>
+              <button
+                type="button"
+                className={styles.btnSecondary}
+                onClick={handleRestart}
+                disabled={restartUiLocked}
+              >
+                <Power size={14} />
+                {isRestarting
+                  ? t("zbsUpdate.restarting")
+                  : t("zbsUpdate.restartServiceBtn")}
+              </button>
+            </div>
+          )}
+        </section>
+      </div>
+    </div>
+  );
+}
diff --git a/dashboard/src/components/zbs/ZbsVersionBadge.tsx b/dashboard/src/components/zbs/ZbsVersionBadge.tsx
