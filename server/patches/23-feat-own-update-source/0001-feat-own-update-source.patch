+"""Patch 23: ZBS version display + official update check disabled."""
+
+from __future__ import annotations
+
+import pytest
+
+from octop.api.routers import update as update_router
+from octop.infra.setup import zbs_version
+
+
+def _settings_server(stable_only: bool | None = None):
+    store: dict[str, str] = {}
+    if stable_only is not None:
+        store["update.stable_only"] = "true" if stable_only else "false"
+
+    class Repo:
+        def get(self, key: str):
+            return store.get(key)
+
+        def set(self, key: str, value: str) -> None:
+            store[key] = value
+
+    return type("Server", (), {"services": type("Svc", (), {"settings_repo": Repo()})()})()
+
+
+def test_read_zbs_version_parses_ours_segment(monkeypatch: pytest.MonkeyPatch) -> None:
+    class StampedFile:
+        def read_text(self, encoding: str):
+            return "1.0.2b6-zbs0.3\n"
+
+    monkeypatch.setattr(zbs_version, "_ZBS_VERSION_FILE", StampedFile())
+    assert zbs_version.read_zbs_version() == "0.3"
+
+
+def test_read_zbs_version_none_when_file_missing(monkeypatch: pytest.MonkeyPatch) -> None:
+    class MissingFile:
+        def read_text(self, encoding: str):
+            raise FileNotFoundError
+
+    monkeypatch.setattr(zbs_version, "_ZBS_VERSION_FILE", MissingFile())
+    assert zbs_version.read_zbs_version() is None
+
+
+def test_read_zbs_version_none_without_marker(monkeypatch: pytest.MonkeyPatch) -> None:
+    class PlainFile:
+        def read_text(self, encoding: str):
+            return "1.0.2b6\n"
+
+    monkeypatch.setattr(zbs_version, "_ZBS_VERSION_FILE", PlainFile())
+    assert zbs_version.read_zbs_version() is None
+
+
+def test_display_version_prefers_zbs_segment(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setattr(zbs_version, "read_zbs_version", lambda: "0.3")
+    assert zbs_version.display_version() == "ZBS0.3"
+
+
+def test_display_version_falls_back_to_official(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setattr(zbs_version, "read_zbs_version", lambda: None)
+    monkeypatch.setattr(
+        "octop.infra.setup.self_update.get_local_version", lambda: "1.0.2b6"
+    )
+    assert zbs_version.display_version() == "1.0.2b6"
+
+
+@pytest.mark.asyncio
+async def test_status_reports_zbs_version_and_never_an_update(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    monkeypatch.setattr(zbs_version, "display_version", lambda: "ZBS0.3")
+    status = await update_router.update_status(_=None, server=_settings_server(True))
+    assert status["current_version"] == "ZBS0.3"
+    assert status["has_update"] is False
+    assert status["latest_version"] is None
+    assert status["error"] is None
+
+
+@pytest.mark.asyncio
+async def test_status_falls_back_to_official_version_without_file(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    monkeypatch.setattr(zbs_version, "display_version", lambda: "1.0.2b6")
+    status = await update_router.update_status(_=None, server=_settings_server())
+    assert status["current_version"] == "1.0.2b6"
+    assert status["has_update"] is False
+
+
+@pytest.mark.asyncio
+async def test_check_endpoint_does_not_probe_pypi(monkeypatch: pytest.MonkeyPatch) -> None:
+    """The web check endpoint must not call PyPI even though the official helper stays."""
+    calls: list[object] = []
+
+    def fail_fetch() -> None:
+        calls.append(1)
+        raise AssertionError("web check endpoint must not touch PyPI")
+
+    monkeypatch.setattr(update_router, "fetch_pypi_info", fail_fetch)
+
+    status = await update_router.check_for_updates(_=None, server=_settings_server())
+    assert calls == []
+    assert status["has_update"] is False
+    assert status["latest_version"] is None
+
+
+@pytest.mark.asyncio
+async def test_trigger_upgrade_is_forbidden() -> None:
+    from octop.infra.errors import OctopError
+
+    with pytest.raises(OctopError) as exc_info:
+        await update_router.trigger_upgrade(
+            body=update_router.UpgradeBody(),
+            server=_settings_server(),
+            _=None,
+        )
+    assert "PyPI" in exc_info.value.message or "image" in exc_info.value.message
