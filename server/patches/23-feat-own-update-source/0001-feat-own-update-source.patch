@@ -0,0 +1,14 @@
+// ZBS build constants (patch 23): own recipe repo + display version rules.
+
+/** 公开配方库（项目地址），头像菜单"项目地址"打开它。 */
+export const ZBS_PROJECT_URL = "https://github.com/byronz1z/ZBSwork-octop-build";
+
+/**
+ * 页面显示的版本号：后端 `zbs_version`（读 zbs_version.txt）已经按规则
+ * 返回 `ZBS0.3`（打了版本号的镜像）或官方版本号（本机开发，读不到文件）。
+ * 前端不再自己拼 `v` 前缀，直接显示后端给的字符串。
+ */
+export function zbsDisplayVersion(currentVersion: string | null | undefined): string | null {
+  if (!currentVersion) return null;
+  return currentVersion;
+}
