+def _local_path_from_file_url(url: str) -> str | None:
+    """Return the host path a ``file:`` URL points at, or ``None``.
+
+    Non-file schemes (http/https/about/data/…) return ``None`` so they are
+    untouched. Leading whitespace and ``view-source:`` prefixes are stripped
+    first — Chromium treats ``view-source:file:///…`` as a plain file view of
+    that path (verified in zt026-octop2: the marker text of a file outside the
+    user's folder is fully readable), so it must be judged by the same rules.
+    ``file:///a/b`` → ``/a/b``; ``file://host/…`` names a host
+    (not meaningful for this deployment) and yields ``""`` so callers refuse
+    it rather than guessing which file was meant.
+    """
+    text = str(url).strip()
+    if not text:
+        return None
+    # view-source: is its own scheme stacked on the real one; Chromium allows
+    # it to be repeated (view-source:view-source:file:…), so strip a run.
+    lowered = text.lower()
+    while lowered.startswith("view-source:"):
+        text = text[len("view-source:") :].lstrip()
+        lowered = text.lower()
+    if not text:
+        return None
+    if not lowered.startswith("file:"):
+        return None
+    body = text[len("file:") :].lstrip()
+    if body.startswith("//"):
+        rest = body[2:]
+        if not rest.startswith("/"):
+            return ""
+        body = rest  # file:///a/b → body "//a/b" → rest "/a/b"
+    if not body.startswith("/"):
+        return ""
+    from urllib.parse import unquote
+
+    return unquote(body)
+
+
+def _is_local_fs_path(value: str) -> bool:
+    """True when *value* is a bare filesystem path (not a URL)."""
+    text = str(value).strip()
+    if not text:
+        return False
+    lowered = text.lower()
+    if "://" in lowered or lowered.startswith(("file:", "about:", "data:", "mailto:")):
+        return False
+    return text.startswith("/")
+
