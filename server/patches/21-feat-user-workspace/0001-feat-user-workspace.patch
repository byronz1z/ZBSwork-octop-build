+def assert_user_may_change_backend(
+    user: Any,
+    *,
+    current_config_json: str | None,
+    new_config: Any,
+    settings_repo: Any,
+) -> None:
+    """ZBS F5: block backend changes on agents when the workspace switch is on.
+
+    Applies to non-admin *user* requests carrying a ``config`` dict whose
+    ``backend`` differs from the agent's stored one — including a *missing*
+    key, since PATCH replaces the whole config (a dropped key would silently
+    revert the agent to the official default backend). Admins pass through.
+    The switch itself is the settings key ``agent_enforced_backend``; when it
+    is unset everything behaves exactly like official Octop.
+    """
+    if user is None or getattr(user, "is_admin", False):
+        return
+    if not isinstance(new_config, dict):
+        return
+    if enforced_workspace_backend_name(settings_repo) is None:
+        return
+    try:
+        stored = json.loads(current_config_json or "{}")
+    except (json.JSONDecodeError, TypeError):
+        stored = {}
+    if not isinstance(stored, dict):
+        stored = {}
+    stored_backend = stored.get("backend")
+    if "backend" in new_config and new_config["backend"] == stored_backend:
+        return
+    raise OctopError(
+        ErrorCode.FORBIDDEN,
+        "agent backend is enforced by the administrator and cannot be changed"
+        " (settings key 'agent_enforced_backend')",
+    )
+
