@@ -0,0 +1,292 @@
+"""Unit tests for the ZBS F11 browser local-file policy.
+
+Covers the ``browser_profile`` middleware's file-address rewriting:
+- ``file:`` URLs to the user's own folder are rewritten to the host path
+- file URLs outside the folder are refused with a Chinese explanation
+- http/https and non-file actions are untouched
+- screenshot ``path`` gets the same treatment
+- alias url keys and action aliases are covered
+- no resolver (switch off / admin) → official behavior
+"""
+
+from __future__ import annotations
+
+from unittest.mock import AsyncMock
+
+import pytest
+from langgraph.prebuilt.tool_node import ToolCallRequest
+
+from octop.infra.agents.middleware import browser_profile
+
+
+def _request(name: str, args: dict[str, object]) -> ToolCallRequest:
+    return ToolCallRequest(
+        tool_call={"name": name, "args": args, "id": "call-1"},
+        tool=None,
+        state={},
+        runtime=None,  # type: ignore[arg-type]
+    )
+
+
+def _patch_user(monkeypatch, user: object = "42") -> None:
+    monkeypatch.setattr(browser_profile, "get_config", lambda: {"configurable": {"user": user}})
+
+
+async def _run(monkeypatch, args: dict[str, object], resolver=None) -> object:
+    _patch_user(monkeypatch)
+    monkeypatch.setattr(
+        browser_profile, "user_browser_profile", lambda uid: f"user-{uid}"
+    )
+    cfg = {"configurable": {"user": "42"}}
+    if resolver is not None:
+        cfg["configurable"]["browser_file_resolver"] = resolver
+    monkeypatch.setattr(browser_profile, "get_config", lambda: cfg)
+    handler = AsyncMock(return_value=object())
+    request = _request("browser_use", args)
+    await browser_profile.BrowserProfileMiddleware().awrap_tool_call(request, handler)
+    return handler
+
+
+def _own(host: str) -> object:
+    def _resolver(uid: int, path: str):
+        return host, True
+
+    return _resolver
+
+
+def _deny() -> object:
+    def _resolver(uid: int, path: str):
+        return "", False
+
+    return _resolver
+
+
+def _off() -> object:
+    def _resolver(uid: int, path: str):
+        return None
+
+    return _resolver
+
+
+@pytest.mark.asyncio
+async def test_file_url_own_folder_rewritten(monkeypatch) -> None:
+    handler = await _run(
+        monkeypatch,
+        {"action": "navigate", "url": "file:///.octop/workspaces/ABC/page.html"},
+        resolver=_own("/srv/users/alice/.octop/workspaces/ABC/page.html"),
+    )
+    forwarded = handler.await_args.args[0]
+    assert forwarded.tool_call["args"]["url"] == (
+        "file:///srv/users/alice/.octop/workspaces/ABC/page.html"
+    )
+    assert forwarded.tool_call["args"]["profile"] == "user-42"
+
+
+@pytest.mark.asyncio
+async def test_file_url_other_user_refused_with_explanation(monkeypatch) -> None:
+    handler = await _run(
+        monkeypatch,
+        {"action": "navigate", "url": "file:///data/.octop/users/bob/secret.txt"},
+        resolver=_deny(),
+    )
+    handler.assert_not_awaited()
+
+
+@pytest.mark.asyncio
+async def test_http_untouched(monkeypatch) -> None:
+    handler = await _run(
+        monkeypatch,
+        {"action": "navigate", "url": "https://example.com/file:maybe"},
+        resolver=_deny(),
+    )
+    forwarded = handler.await_args.args[0]
+    assert forwarded.tool_call["args"]["url"] == "https://example.com/file:maybe"
+
+
+@pytest.mark.asyncio
+async def test_new_tab_url_covered(monkeypatch) -> None:
+    handler = await _run(
+        monkeypatch,
+        {"action": "new_tab", "url": "file:///etc/passwd"},
+        resolver=_deny(),
+    )
+    handler.assert_not_awaited()
+
+
+@pytest.mark.asyncio
+async def test_alias_url_key_covered(monkeypatch) -> None:
+    handler = await _run(
+        monkeypatch,
+        {"action": "navigate", "href": "file:///data/.octop/users/bob/x.txt"},
+        resolver=_deny(),
+    )
+    handler.assert_not_awaited()
+
+
+@pytest.mark.asyncio
+async def test_goto_alias_covered(monkeypatch) -> None:
+    handler = await _run(
+        monkeypatch,
+        {"action": "goto", "url": "file:///data/.octop/users/bob/x.txt"},
+        resolver=_deny(),
+    )
+    handler.assert_not_awaited()
+
+
+@pytest.mark.asyncio
+async def test_screenshot_path_outside_refused(monkeypatch) -> None:
+    handler = await _run(
+        monkeypatch,
+        {"action": "screenshot", "path": "/etc/octop/shot.png"},
+        resolver=_deny(),
+    )
+    handler.assert_not_awaited()
+
+
+@pytest.mark.asyncio
+async def test_screenshot_path_inside_rewritten(monkeypatch) -> None:
+    handler = await _run(
+        monkeypatch,
+        {"action": "screenshot", "path": "/.octop/workspaces/ABC/out/shot.png"},
+        resolver=_own("/srv/users/alice/.octop/workspaces/ABC/out/shot.png"),
+    )
+    forwarded = handler.await_args.args[0]
+    assert forwarded.tool_call["args"]["path"] == (
+        "/srv/users/alice/.octop/workspaces/ABC/out/shot.png"
+    )
+
+
+@pytest.mark.asyncio
+async def test_screenshot_relative_path_untouched(monkeypatch) -> None:
+    # Relative paths land under the workspace screenshots dir — not a
+    # host-absolute path, so the policy leaves them alone.
+    handler = await _run(
+        monkeypatch,
+        {"action": "screenshot", "path": "shot.png"},
+        resolver=_deny(),
+    )
+    forwarded = handler.await_args.args[0]
+    assert forwarded.tool_call["args"]["path"] == "shot.png"
+
+
+@pytest.mark.asyncio
+async def test_no_resolver_official_behavior(monkeypatch) -> None:
+    handler = await _run(
+        monkeypatch,
+        {"action": "navigate", "url": "file:///etc/passwd"},
+        resolver=None,
+    )
+    forwarded = handler.await_args.args[0]
+    assert forwarded.tool_call["args"]["url"] == "file:///etc/passwd"
+    assert forwarded.tool_call["args"]["profile"] == "user-42"
+
+
+@pytest.mark.asyncio
+async def test_resolver_none_keeps_call(monkeypatch) -> None:
+    # resolver present but returns None (switch off / admin mid-turn)
+    handler = await _run(
+        monkeypatch,
+        {"action": "navigate", "url": "file:///etc/passwd"},
+        resolver=_off(),
+    )
+    forwarded = handler.await_args.args[0]
+    assert forwarded.tool_call["args"]["url"] == "file:///etc/passwd"
+
+
+@pytest.mark.asyncio
+async def test_file_url_with_host_refused(monkeypatch) -> None:
+    # file://host/path names a host — refuse rather than guess.
+    handler = await _run(
+        monkeypatch,
+        {"action": "navigate", "url": "file://localhost/etc/passwd"},
+        resolver=_own("/etc/passwd"),
+    )
+    handler.assert_not_awaited()
+
+
+@pytest.mark.asyncio
+async def test_other_actions_untouched(monkeypatch) -> None:
+    handler = await _run(
+        monkeypatch,
+        {"action": "dom_tree", "url": "whatever"},
+        resolver=_deny(),
+    )
+    forwarded = handler.await_args.args[0]
+    assert forwarded.tool_call["args"]["url"] == "whatever"
+
+
+def test_local_path_from_file_url_parsing() -> None:
+    assert browser_profile._local_path_from_file_url("file:///a/b") == "/a/b"
+    assert browser_profile._local_path_from_file_url("FILE:///a/B") == "/a/B"
+    assert browser_profile._local_path_from_file_url("file:///a/%E4%B8%AD") == "/a/中"
+    assert browser_profile._local_path_from_file_url("https://x/y") is None
+    assert browser_profile._local_path_from_file_url("about:blank") is None
+    assert browser_profile._local_path_from_file_url("file://host/a") == ""
+
+
+def test_local_path_from_file_url_view_source_prefix() -> None:
+    """ZBS round 6: ``view-source:file:///…`` is judged by the same rules.
+
+    Chromium opens it as a plain view of that file (verified in
+    zt026-octop2: a marker file outside the user's folder was fully
+    readable through ``view-source:file://``), so the prefix must be
+    stripped before the file policy decides.
+    """
+    assert browser_profile._local_path_from_file_url(
+        "view-source:file:///data/.octop/users/bob/secret.txt"
+    ) == "/data/.octop/users/bob/secret.txt"
+    # Leading whitespace around the whole value / between prefixes.
+    assert browser_profile._local_path_from_file_url(
+        "  view-source:  file:///a/b"
+    ) == "/a/b"
+    # Repeated prefixes are Chromium-legal and stripped the same way.
+    assert browser_profile._local_path_from_file_url(
+        "view-source:view-source:file:///a/b"
+    ) == "/a/b"
+    # http(s) under view-source stays untouched (still not a file: URL).
+    assert browser_profile._local_path_from_file_url(
+        "view-source:https://example.com/x"
+    ) is None
+
+
+@pytest.mark.asyncio
+async def test_view_source_file_url_other_user_refused(monkeypatch) -> None:
+    handler = await _run(
+        monkeypatch,
+        {
+            "action": "navigate",
+            "url": "view-source:file:///data/.octop/users/bob/secret.txt",
+        },
+        resolver=_deny(),
+    )
+    handler.assert_not_awaited()
+
+
+@pytest.mark.asyncio
+async def test_own_folder_filename_percent_encoded(monkeypatch) -> None:
+    """ZBS round 6: allowed paths are percent-encoded so spaces, non-ASCII
+    and ``#`` survive the URL round-trip (``#`` starts the fragment and
+    truncated the path in zt026-octop2)."""
+    host = "/srv/users/alice/.octop/workspaces/ABC/中文 测试#1.html"
+    handler = await _run(
+        monkeypatch,
+        {"action": "navigate", "url": "file:///.octop/workspaces/ABC/page.html"},
+        resolver=_own(host),
+    )
+    forwarded = handler.await_args.args[0]
+    assert forwarded.tool_call["args"]["url"] == (
+        "file:///srv/users/alice/.octop/workspaces/ABC/%E4%B8%AD%E6%96%87%20%E6%B5%8B%E8%AF%95%231.html"
+    )
+
+
+@pytest.mark.asyncio
+async def test_refusal_message_is_chinese_explanation(monkeypatch) -> None:
+    _patch_user(monkeypatch)
+    cfg = {"configurable": {"user": "42", "browser_file_resolver": _deny()}}
+    monkeypatch.setattr(browser_profile, "get_config", lambda: cfg)
+    handler = AsyncMock(return_value=object())
+    request = _request("browser_use", {"action": "navigate", "url": "file:///data/other.txt"})
+    result = await browser_profile.BrowserProfileMiddleware().awrap_tool_call(request, handler)
+    handler.assert_not_awaited()
+    assert "你自己文件夹里的文件" in str(result.content)
+    assert "替代" in str(result.content) or "请" in str(result.content)
