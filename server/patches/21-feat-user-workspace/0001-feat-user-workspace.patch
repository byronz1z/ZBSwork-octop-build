+        raw_path_keys = ["path"] if str(args.get("path") or "").strip() else []
+    if not raw_url_keys and not raw_path_keys:
+        return request
+
+    new_args = dict(args)
+    for key in raw_url_keys:
+        value = str(args[key])
+        path = _local_path_from_file_url(value)
+        if path is None:
+            continue  # http(s)/other scheme — untouched
+        if path == "":
+            return _refuse(request, tool_call, _BLOCKED_FILE_URL)
+        resolved = file_resolver(user_id, path)
+        if resolved is None:
+            continue  # switch off / admin — official behavior
+        host_path, allowed = resolved
+        if not allowed:
+            return _refuse(request, tool_call, _BLOCKED_FILE_URL)
+        # Percent-encode the path so filenames with spaces, non-ASCII
+        # characters, ``#`` or ``?`` survive the round-trip (agent-spoken
+        # plain paths would otherwise break on ``#`` — Chromium treats it as
+        # the fragment delimiter, verified in zt026-octop2).
+        from urllib.parse import quote
+
+        new_args[key] = "file://" + quote(host_path, safe="/:")
+
+    for key in raw_path_keys:
+        value = str(args[key])
+        if not _is_local_fs_path(value):
+            continue  # relative paths land under the workspace screenshots dir
+        resolved = file_resolver(user_id, value)
+        if resolved is None:
+            continue
+        host_path, allowed = resolved
+        if not allowed:
+            return _refuse(request, tool_call, _BLOCKED_PATH)
+        new_args[key] = host_path
+
+    return request.override(tool_call={**tool_call, "args": new_args})
+
+
+def _refuse(request: ToolCallRequest, tool_call: dict[str, Any], message: str) -> ToolMessage:
+    logger.info("browser_use local-file policy: %s", message)
+    return ToolMessage(
+        content=message,
+        tool_call_id=str(tool_call.get("id") or ""),
+        status="error",
+    )
+
 
