+"""Unit tests for the ZBS enforced per-user workspace policy (settings switch).
+
+Covers:
+- ``AgentManager.create`` backend override for non-admin owners (F4)
+- ``assert_user_may_change_backend`` guard for agent PATCH (F5)
+- ``enforced_workspace_backend_name`` settings-key reading (switch on/off)
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+
+from octop.api.common.validators import assert_user_may_change_backend
+from octop.config import OctopConfig
+from octop.infra.agents.manager import AgentCreateSpec, AgentManager
+from octop.infra.db.migrate import run_migrations
+from octop.infra.db.pool import SqlitePool
+from octop.infra.db.services import build_shared_services
+from octop.infra.errors import ErrorCode, OctopError
+from octop.infra.users.identity import Role, User
+from octop.infra.users.resource_policy import (
+    ENFORCED_WORKSPACE_BACKEND_SETTINGS_KEY,
+    enforced_workspace_backend_name,
+)
+from octop.infra.utils.paths import PathLayout
+
+
+@pytest.fixture
+def manager(tmp_path: Path) -> AgentManager:
+    paths = PathLayout(tmp_path / ".octop")
+    paths.ensure_root()
+    db = SqlitePool(paths.db)
+    run_migrations(db)
+    services = build_shared_services(db=db, paths=paths, config=OctopConfig())
+    return AgentManager(repos=services.repos, paths=services.paths)
+
+
+def _seed_user(manager: AgentManager, *, role: str, name: str = "alice") -> int:
+    return manager._repos.user_repo.create(username=name, role=role, password_hash=None)
+
+
+def _switch_on(manager: AgentManager, name: str = "per-user-home") -> None:
+    manager._repos.storage_backend_repo.create(
+        name=name,
+        kind="shell",
+        endpoint=None,
+        access_key=None,
+        secret_key=None,
+        bucket=None,
+        region=None,
+        config_json=json.dumps(
+            {
+                "root_dir": "/data/.octop/users/{username}",
+                "inherit_env": False,
+                "env": {"SSL_CERT_FILE": "/usr/lib/ssl/certs.pem"},
+            }
+        ),
+        note=None,
+    )
+    manager._repos.settings_repo.set(ENFORCED_WORKSPACE_BACKEND_SETTINGS_KEY, name)
+
+
+def _set_enabled(manager: AgentManager, name: str, enabled: bool) -> None:
+    """Flip a seeded storage backend's enabled flag directly on the repo."""
+    repo = manager._repos.storage_backend_repo
+    row = repo.get_by_name(name)
+    assert row is not None
+    repo.update(row.id, enabled=enabled)
+
+
+# ---------------------------------------------------------------------------
+# switch reading
+# ---------------------------------------------------------------------------
