+def test_backup_staging_dir_prefers_env_override(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    store, _, _, _ = _load_backup_modules(monkeypatch)
+    layout = PathLayout(tmp_path / ".octop")
+    custom = tmp_path / "custom-staging"
+    monkeypatch.setenv("OCTOP_BACKUP_STAGING_DIR", str(custom))
+
+    chmod_calls: list[tuple[Path, int]] = []
+    real_chmod = os.chmod
+
+    def spy_chmod(path: os.PathLike[str] | str, mode: int, *args: Any, **kwargs: Any) -> None:
+        chmod_calls.append((Path(path), mode))
+        real_chmod(path, mode, *args, **kwargs)
+
+    monkeypatch.setattr(os, "chmod", spy_chmod)
+
+    resolved = store.backup_staging_dir(layout)
+    assert resolved == custom
+    assert custom.is_dir()
+    assert not (layout.backups_dir / ".staging").exists()
+    assert (custom, 0o700) in chmod_calls
+    if os.name == "posix":
+        assert stat.S_IMODE(custom.stat().st_mode) == 0o700
+
+    # Env override also works when paths is None.
+    assert store.backup_staging_dir(None) == custom
+
+
+def test_backup_staging_dir_derives_from_backups_dir_with_0700(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    store, _, _, _ = _load_backup_modules(monkeypatch)
+    monkeypatch.delenv("OCTOP_BACKUP_STAGING_DIR", raising=False)
+    layout = PathLayout(tmp_path / ".octop")
+
+    chmod_calls: list[tuple[Path, int]] = []
+    real_chmod = os.chmod
+
+    def spy_chmod(path: os.PathLike[str] | str, mode: int, *args: Any, **kwargs: Any) -> None:
+        chmod_calls.append((Path(path), mode))
+        real_chmod(path, mode, *args, **kwargs)
+
+    monkeypatch.setattr(os, "chmod", spy_chmod)
+
+    resolved = store.backup_staging_dir(layout)
+    expected = layout.backups_dir / ".staging"
+    assert resolved == expected
+    assert expected.is_dir()
+    assert (expected, 0o700) in chmod_calls
+    if os.name == "posix":
+        assert stat.S_IMODE(expected.stat().st_mode) == 0o700
+
+    # Whitespace-only env var falls back to backups_dir/.staging.
+    monkeypatch.setenv("OCTOP_BACKUP_STAGING_DIR", "   ")
+    assert store.backup_staging_dir(layout) == expected
+
+    # .staging directory must never show up in list_backup_files.
+    assert store.list_backup_files(layout) == []
+
