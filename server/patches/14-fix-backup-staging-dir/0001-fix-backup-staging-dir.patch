+def test_auto_and_manual_and_export_backup_never_use_system_tmp(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    store, auto, _, router = _load_backup_modules(monkeypatch)
+    monkeypatch.delenv("OCTOP_BACKUP_STAGING_DIR", raising=False)
+    layout = PathLayout(tmp_path / ".octop")
+    expected_staging = (layout.backups_dir / ".staging").resolve()
+    system_tmp = Path(tempfile.gettempdir()).resolve()
+    assert expected_staging != system_tmp
+
+    observed_dests: list[Path] = []
+
+    def fake_create_system_backup(*, dest: Path, **_kwargs: Any) -> str:
+        observed_dests.append(Path(dest).resolve())
+        Path(dest).write_bytes(b"fake-archive")
+        return "octop-backup-20261127T000000Z.tar.gz"
+
+    monkeypatch.setattr(auto, "create_system_backup", fake_create_system_backup)
+    monkeypatch.setattr(router, "create_system_backup", fake_create_system_backup)
+
+    # 1. Auto backup
+    entry, deleted = auto.create_and_store_auto_backup(
+        paths=layout,
+        agent_rows=[],
+        pool=SimpleNamespace(),
+        db_config=SimpleNamespace(),
+        retention_count=5,
+    )
+    assert deleted == []
+    assert entry.name == "octop-auto-backup-20261127T000000Z.tar.gz"
+    assert observed_dests[-1].is_relative_to(expected_staging)
+
+    # 2. Manual backup
+    manual_entry = router._create_and_store_manual_backup(
+        paths=layout,
+        agent_rows=[],
+        pool=SimpleNamespace(),
+        db_config=SimpleNamespace(),
+        options=router.CreateBackupBody(),
+    )
+    assert manual_entry.name == "octop-backup-20261127T000000Z.tar.gz"
+    assert observed_dests[-1].is_relative_to(expected_staging)
+
+    # 3. Ephemeral export
+    export_path, export_name = router._create_ephemeral_backup(
+        paths=layout,
+        agent_rows=[],
+        pool=SimpleNamespace(),
+        db_config=SimpleNamespace(),
+        options=router.CreateBackupBody(),
+    )
+    try:
+        assert export_name == "octop-backup-20261127T000000Z.tar.gz"
+        assert export_path.resolve().is_relative_to(expected_staging)
+        assert observed_dests[-1].is_relative_to(expected_staging)
+    finally:
+        export_path.unlink(missing_ok=True)
+
+    # 4. Env override routes temp dirs to OCTOP_BACKUP_STAGING_DIR
+    env_staging = (tmp_path / "env-staging").resolve()
+    monkeypatch.setenv("OCTOP_BACKUP_STAGING_DIR", str(env_staging))
+    router._create_and_store_manual_backup(
+        paths=layout,
+        agent_rows=[],
+        pool=SimpleNamespace(),
+        db_config=SimpleNamespace(),
+        options=router.CreateBackupBody(),
+    )
+    assert observed_dests[-1].is_relative_to(env_staging)
+    assert store.backup_staging_dir(layout) == env_staging
+
