+def backup_staging_dir(paths: PathLayout | None = None) -> Path | None:
+    """Resolve and ensure the staging directory for backup/restore temp files.
+
+    Precedence:
+    1. ``OCTOP_BACKUP_STAGING_DIR`` environment variable (when non-empty).
+    2. ``paths.backups_dir / ".staging"`` (keeps staging on the same filesystem
+       as stored archives for atomic moves and avoids container ``/tmp`` spikes).
+    3. ``None`` when neither is available (falls back to OS default temp dir).
+    """
+    raw = os.environ.get(BACKUP_STAGING_DIR_ENV, "").strip()
+    if raw:
+        staging = Path(raw).expanduser()
+    elif paths is not None:
+        staging = paths.backups_dir / _BACKUP_STAGING_SUBDIR
+    else:
+        return None
+    staging.mkdir(parents=True, exist_ok=True)
+    try:
+        os.chmod(staging, 0o700)
+    except OSError:
+        pass
+    return staging
 
 
