+def _load_backup_modules(
+    monkeypatch: pytest.MonkeyPatch,
+) -> tuple[ModuleType, ModuleType, ModuleType, ModuleType]:
+    """Import real backup modules; stub transitive runtime deps only when absent."""
+    try:
+        store = importlib.import_module("octop.infra.backup.store")
+        auto = importlib.import_module("octop.infra.backup.auto")
+        system_archive = importlib.import_module("octop.infra.backup.system_archive")
+        router = importlib.import_module("octop.api.routers.backup")
+        return store, auto, system_archive, router
+    except ModuleNotFoundError:
+        pass
+
+    class _StubOctopError(Exception):
+        def __init__(self, code: Any, message: str = "", **kwargs: Any) -> None:
+            super().__init__(message)
+            self.code = code
+            self.message = message
+            self.kwargs = kwargs
+
+    class _StubErrorCode:
+        SLASH_BAD_ARGS = "SLASH_BAD_ARGS"
+        NOT_FOUND = "NOT_FOUND"
+        INTERNAL_ERROR = "INTERNAL_ERROR"
+        BACKUP_IN_PROGRESS = "BACKUP_IN_PROGRESS"
+        BACKUP_DRIVER_MISMATCH = "BACKUP_DRIVER_MISMATCH"
+        BACKUP_SCHEMA_INCOMPATIBLE = "BACKUP_SCHEMA_INCOMPATIBLE"
+
+    class _StubSqlitePool:
+        dialect = "sqlite"
+
+        def __init__(self, path: Path) -> None:
+            self.path = path
+
+    class _StubDatabaseConfig:
+        def postgresql_conninfo(self) -> str:
+            return ""
+
+    stub_modules: dict[str, dict[str, Any]] = {
+        "octop.infra.errors": {
+            "ErrorCode": _StubErrorCode,
+            "OctopError": _StubOctopError,
+        },
+        "octop.config": {
+            "BackupConfig": SimpleNamespace,
+            "DatabaseConfig": _StubDatabaseConfig,
+            "OctopConfig": SimpleNamespace,
+            "load_config": lambda *_a, **_kw: SimpleNamespace(),
+        },
+        "octop.infra.cron": {},
+        "octop.infra.cron.trigger": {"build_trigger": lambda *_a, **_kw: None},
+        "octop.infra.db": {},
+        "octop.infra.db.migrate": {
+            "_current_version": lambda *_a, **_kw: 1,
+            "_max_discovered_version": lambda *_a, **_kw: 1,
+            "run_migrations": lambda *_a, **_kw: None,
+        },
+        "octop.infra.db.pool": {
+            "DatabasePool": object,
+            "SqlitePool": _StubSqlitePool,
+        },
+        "octop.infra.db.repos": {},
+        "octop.infra.db.repos.agents": {
+            "AgentRepo": lambda _pool: SimpleNamespace(get=lambda _id: None),
+        },
+        "octop.infra.db.repos.audit": {"ACTOR_ADMIN": "admin", "ACTOR_SYSTEM": "system"},
+        "octop.infra.db.repos.secrets": {
+            "SecretRepo": lambda _pool: SimpleNamespace(get_or_create=lambda *_a, **_kw: None),
+        },
+        "octop.infra.agents": {},
+        "octop.infra.agents.workspace": {},
+        "octop.infra.agents.workspace.dir": {
+            "system_files_path_from_config": lambda *_a, **_kw: "",
+            "workspace_dir_from_config_json": lambda *_a, **_kw: Path("."),
+        },
+        "octop.infra.backup.chats": {
+            "CHAT_TABLES_CHILD_FIRST": (),
+            "capture_chat_tables": lambda *_a, **_kw: None,
+            "is_chat_workspace_rel": lambda *_a, **_kw: False,
+            "restore_preserved_chats": lambda *_a, **_kw: (0, 0),
+            "strip_chat_tables_from_sqlite_file": lambda *_a, **_kw: None,
+        },
+        "octop.infra.backup.pg_dump": {
+            "dump_postgres": lambda *_a, **_kw: None,
+            "restore_postgres": lambda *_a, **_kw: None,
+        },
+        "octop.infra.backup.workspace_archive": {
+            "export_workspace_zip": lambda *_a, **_kw: None,
+            "import_workspace_zip": lambda *_a, **_kw: None,
+        },
+        "octop.infra.backup.snapshot": {
+            "capture_jwt_secret_from_pool": lambda *_a, **_kw: None,
+            "capture_users_from_pool": lambda *_a, **_kw: [],
+            "infer_owner_user_id": lambda *_a, **_kw: None,
+            "prune_users_not_in": lambda *_a, **_kw: None,
