+def test_system_archive_create_and_restore_stage_outside_system_tmp(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    _, _, system_archive, _ = _load_backup_modules(monkeypatch)
+    monkeypatch.delenv("OCTOP_BACKUP_STAGING_DIR", raising=False)
+    layout = PathLayout(tmp_path / ".octop")
+    layout.ensure_root()
+    expected_staging = (layout.backups_dir / ".staging").resolve()
+
+    recorded_dirs: list[Path] = []
+    real_tempdir = tempfile.TemporaryDirectory
+
+    def spy_tempdir(*args: Any, **kwargs: Any) -> tempfile.TemporaryDirectory[str]:
+        if kwargs.get("dir") is not None:
+            recorded_dirs.append(Path(kwargs["dir"]).resolve())
+        return real_tempdir(*args, **kwargs)
+
+    monkeypatch.setattr(system_archive.tempfile, "TemporaryDirectory", spy_tempdir)
+
+    db_cfg_mod = importlib.import_module("octop.config")
+    pool = system_archive.SqlitePool(layout.db)
+    if not layout.db.is_file():
+        layout.db.write_bytes(b"sqlite-stub")
+    archive = tmp_path / "out.tar.gz"
+
+    try:
+        system_archive.create_system_backup(
+            paths=layout,
+            agent_rows=[],
+            pool=pool,
+            db_config=db_cfg_mod.DatabaseConfig(),
+            dest=archive,
+            include_config=False,
+            include_workspaces=False,
+            include_skill_packages=False,
+            include_plugins=False,
+            include_knowledge=False,
+            include_chats=False,
+        )
+        assert recorded_dirs == [expected_staging]
+        assert archive.is_file()
+
+        # Restore also stages inside expected_staging / env override rather than system /tmp.
+        custom_env = (tmp_path / "restore-staging").resolve()
+        monkeypatch.setenv("OCTOP_BACKUP_STAGING_DIR", str(custom_env))
+        system_archive.restore_system_backup(
+            archive,
+            paths=layout,
+            pool=pool,
+            db_config=db_cfg_mod.DatabaseConfig(),
+            restore_config=False,
+        )
+        assert recorded_dirs[-1] == custom_env
+    finally:
+        close = getattr(pool, "close", None)
+        if callable(close):
+            close()
