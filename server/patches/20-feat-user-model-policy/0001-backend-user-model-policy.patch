+# ZBS patch 20: model whitelist policy (deliberately declared here, below the
+# official policy trio, so patches that patch the import block or the policy
+# constants keep their original context lines).
+POLICY_ALLOWED_MODELS = "allowed_models"
+
+
+def allowed_models_of(raw: Any) -> list[str] | None:
+    """Parse an ``allowed_models`` policy value; ``None`` means unrestricted.
+
+    Stored shape is a JSON array of ``provider/model`` refs (ZBS). Malformed
+    rows read as unrestricted, matching how the other ``*_of`` helpers treat
+    unparsable values.
+    """
+    if isinstance(raw, Mapping) and "value" not in raw:
+        raw = raw.get(POLICY_ALLOWED_MODELS)
+    text = active_policy_value(raw)
+    if text is None:
+        return None
+    try:
+        parsed = json.loads(text)
+    except (TypeError, ValueError):
+        return None
+    if not isinstance(parsed, list):
+        return None
+    refs = [str(item).strip() for item in parsed if isinstance(item, str) and str(item).strip()]
+    return refs or None
+
+
+def normalize_allowed_models(raw: list[str] | Sequence[str] | None) -> list[str] | None:
+    """Validate and canonicalize an ``allowed_models`` request value.
+
+    ``None`` / empty clears the policy (unrestricted). Every entry must be a
+    ``provider/model`` ref; duplicates collapse preserving order.
+    """
+    if raw is None:
+        return None
+    refs: list[str] = []
+    seen: set[str] = set()
+    for item in raw:
+        ref = str(item).strip()
+        if not ref:
+            continue
+        provider_name, _, model_id = ref.partition("/")
+        if not provider_name or not model_id or "/" in model_id:
+            raise OctopError(
+                ErrorCode.FORBIDDEN,
+                f"allowed_models entries must be 'provider/model' refs, got: {ref!r}",
+                status=400,
+            )
+        if ref not in seen:
+            seen.add(ref)
+            refs.append(ref)
+    return refs or None
+
+
+def allowed_models_json(refs: list[str] | None) -> str | None:
+    """Serialize normalized refs for the ``user_policies.value`` TEXT column."""
+    return None if refs is None else json.dumps(refs)
+
+
+def allowed_models_for_user(user_row: Any) -> list[str] | None:
+    """Effective model whitelist for a ``users`` row; ``None`` = unrestricted.
+
+    Admins are never restricted (role template API stores no policies for the
+    admin role — same official semantics as the other resource policies).
+    Inline admin check (official pattern, cf. ``cron/delivery.py``) keeps this
+    patch self-contained; patch 21 later adds the ``user_row_is_admin`` helper
+    for the same role string.
+    """
+    if user_row is None:
+        return None
+    if str(getattr(user_row, "role", "") or "") == "admin":
+        return None
+    return allowed_models_of(getattr(user_row, "allowed_models", None))
+
