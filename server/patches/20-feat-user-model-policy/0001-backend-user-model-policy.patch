@@ -0,0 +1,377 @@
+"""ZBS patch 20 — allowed_models HTTP surface (F7/F9/F11 + F8 entry checks)."""
+
+from __future__ import annotations
+
+import json
+
+from tests.support.auth import (
+    auth_header,
+    bootstrap_admin,
+    create_user,
+    resolve_user_id,
+    seed_openai_provider,
+)
+
+
+async def _seed_providers(c, auth: dict[str, str]) -> None:
+    """Two usable providers: openai/gpt-4o (text) and openai/gpt-4o-vision."""
+    await seed_openai_provider(c, auth)
+    r = await c.post(
+        "/api/admin/providers",
+        headers=auth,
+        json={
+            "name": "second",
+            "kind": "openai",
+            "base_url": "https://second.example/v1",
+            "api_key": "k2",
+            "models": [
+                {
+                    "id": "m2",
+                    "name": "M2",
+                    "enabled": True,
+                    "input": ["text"],
+                    "thinking": False,
+                }
+            ],
+        },
+    )
+    assert r.status_code == 201, r.text
+
+
+async def test_admin_can_set_allowed_models_on_user(env) -> None:
+    c, _srv, auth = env
+    await _seed_providers(c, auth)
+
+    r = await c.post(
+        "/api/users",
+        headers=auth,
+        json={
+            "username": "alice",
+            "password": "TestPass12",
+            "role": "user",
+            "allowed_models": ["openai/gpt-4o"],
+        },
+    )
+    assert r.status_code == 201, r.text
+    assert r.json()["allowed_models"] == ["openai/gpt-4o"]
+
+    uid = r.json()["id"]
+    # PATCH overrides per-user.
+    r = await c.patch(
+        f"/api/users/{uid}",
+        headers=auth,
+        json={"allowed_models": ["openai/gpt-4o", "second/m2"]},
+    )
+    assert r.status_code == 200, r.text
+    assert r.json()["allowed_models"] == ["openai/gpt-4o", "second/m2"]
+
+    # PATCH null clears the whitelist.
+    r = await c.patch(f"/api/users/{uid}", headers=auth, json={"allowed_models": None})
+    assert r.status_code == 200, r.text
+    assert r.json()["allowed_models"] is None
+
+    # Invalid refs are rejected.
+    r = await c.post(
+        "/api/users",
+        headers=auth,
+        json={
+            "username": "bob",
+            "password": "TestPass12",
+            "role": "user",
+            "allowed_models": ["gpt-4o"],
+        },
+    )
+    assert r.status_code == 400, r.text
+
+
+async def test_batch_set_allowed_models(env) -> None:
+    c, _srv, auth = env
+    await _seed_providers(c, auth)
+    uids = []
+    for name in ("alice", "bob"):
+        r = await c.post(
+            "/api/users",
+            headers=auth,
+            json={"username": name, "password": "TestPass12", "role": "user"},
+        )
+        uids.append(r.json()["id"])
+
+    r = await c.post(
+        "/api/users/batch",
+        headers=auth,
+        json={
+            "user_ids": uids,
+            "action": "set_allowed_models",
+            "allowed_models": ["openai/gpt-4o"],
+        },
+    )
+    assert r.status_code == 200, r.text
+    assert r.json()["succeeded"] == 2
+
+    rows = {u["username"]: u for u in (await c.get("/api/users", headers=auth)).json()}
+    assert rows["alice"]["allowed_models"] == ["openai/gpt-4o"]
+    assert rows["bob"]["allowed_models"] == ["openai/gpt-4o"]
+
+    # Null clears the whitelist for everyone.
+    r = await c.post(
+        "/api/users/batch",
+        headers=auth,
+        json={"user_ids": uids, "action": "set_allowed_models", "allowed_models": None},
+    )
+    assert r.status_code == 200, r.text
+    rows = {u["username"]: u for u in (await c.get("/api/users", headers=auth)).json()}
+    assert rows["alice"]["allowed_models"] is None
+
+
+async def test_role_template_carries_allowed_models(env) -> None:
+    c, _srv, auth = env
+    await _seed_providers(c, auth)
+
+    r = await c.post(
+        "/api/users/roles",
+        headers=auth,
+        json={
+            "user_role_name": "受限",
+            "permissions": [],
+            "policies": [
+                {"name": "token_quota", "value": "1000"},
+                {"name": "allowed_models", "value": json.dumps(["openai/gpt-4o"])},
+            ],
+        },
+    )
+    assert r.status_code == 201, r.text
+    role = r.json()
+    assert role["allowed_models"] == ["openai/gpt-4o"]
+    assert {"name": "allowed_models", "value": '["openai/gpt-4o"]'} in role["policies"]
+    role_id = role["user_role_id"]
+
+    # Assigning the role copies the whitelist onto the user (official
+    # full-replace semantics).
+    r = await c.post(
+        "/api/users",
+        headers=auth,
+        json={
+            "username": "carol",
+            "password": "TestPass12",
+            "role": role_id,
+        },
+    )
+    assert r.status_code == 201, r.text
+    assert r.json()["allowed_models"] == ["openai/gpt-4o"]
+    assert r.json()["token_quota"] == 1000
+
+    # Switching to the plain user role clears the whitelist (full replace).
+    uid = r.json()["id"]
+    r = await c.patch(
+        f"/api/users/{uid}", headers=auth, json={"role": "user"}
+    )
+    assert r.status_code == 200, r.text
+    assert r.json()["allowed_models"] is None
+    assert r.json()["token_quota"] is None
+
+
+async def test_resolved_models_filtered_for_restricted_user(env) -> None:
+    c, _srv, auth = env
+    await _seed_providers(c, auth)
+    alice = await create_user(c, auth, username="alice")
+    alice_id = await resolve_user_id(c, auth, "alice")
+
+    # Unrestricted user sees all resolved models.
+    r = await c.get("/api/providers/resolved", headers=alice)
+    assert r.status_code == 200
+    all_refs = {f"{m['provider_name']}/{m['model']}" for m in r.json()}
+    assert all_refs == {"openai/gpt-4o", "second/m2"}
+
+    # Restricted user only sees whitelisted models.
+    r = await c.patch(
+        f"/api/users/{alice_id}", headers=auth, json={"allowed_models": ["second/m2"]}
+    )
+    assert r.status_code == 200, r.text
+    r = await c.get("/api/providers/resolved", headers=alice)
+    assert r.status_code == 200
+    refs = {f"{m['provider_name']}/{m['model']}" for m in r.json()}
+    assert refs == {"second/m2"}
+
+    # Admin always sees everything.
+    r = await c.get("/api/providers/resolved", headers=auth)
+    assert {f"{m['provider_name']}/{m['model']}" for m in r.json()} == all_refs
+
+
+async def test_provider_api_key_hidden_from_non_admin(env) -> None:
+    c, _srv, auth = env
+    await _seed_providers(c, auth)
+    alice = await create_user(c, auth, username="alice")
+
+    # Non-admin: no api_key in the payload.
+    r = await c.get("/api/providers", headers=alice)
+    assert r.status_code == 200
+    for row in r.json():
+        assert row["api_key"] is None
+        assert row["name"] in {"openai", "second"}
+
+    # Admin: full key (official behavior).
+    r = await c.get("/api/providers", headers=auth)
+    assert r.status_code == 200
+    by_name = {row["name"]: row for row in r.json()}
+    assert by_name["openai"]["api_key"] == "k"
+    assert by_name["second"]["api_key"] == "k2"
+
+    # Admin management endpoint unaffected.
+    r = await c.get("/api/admin/providers", headers=auth)
+    assert r.status_code == 200
+    assert {row["name"]: row for row in r.json()}["openai"]["api_key"] == "k"
+
+
