@@ -0,0 +1,141 @@
+"""ZBS patch 20 — ProviderStore allowlist filtering (F8: vision upgrade, fallback)."""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+
+from octop.config import OctopConfig
+from octop.infra.agents.providers.store import ProviderStore
+from octop.infra.db.migrate import run_migrations
+from octop.infra.db.pool import SqlitePool
+from octop.infra.db.services import build_shared_services
+
+
+@pytest.fixture
+def store(tmp_path: Path) -> ProviderStore:
+    pool = SqlitePool(tmp_path / "octop.db")
+    run_migrations(pool)
+    services = build_shared_services(db=pool, paths=tmp_path, config=OctopConfig())
+    return ProviderStore(provider_repo=services.repos.provider_repo)
+
+
+def _add_provider(store: ProviderStore, name: str, models: list[dict]) -> None:
+    import json
+
+    repo = store._provider_repo  # noqa: SLF001 - test helper
+    repo.create(
+        name=name,
+        kind="openai",
+        base_url=f"https://{name}.example/v1",
+        api_key=f"sk-{name}",
+        models_json=json.dumps(models),
+    )
+
+
+def _model(mid: str, image: bool = False) -> dict:
+    return {
+        "id": mid,
+        "name": mid,
+        "enabled": True,
+        "input": ["text", "image"] if image else ["text"],
+        "thinking": False,
+    }
+
+
+def test_resolve_first_model_ref_respects_allowlist(store: ProviderStore) -> None:
+    _add_provider(store, "a", [_model("m1"), _model("m2")])
+    _add_provider(store, "b", [_model("m3")])
+    assert store.resolve_first_model_ref() == "a/m1"
+    assert store.resolve_first_model_ref(["a/m2"]) == "a/m2"
+    assert store.resolve_first_model_ref(["b/m3"]) == "b/m3"
+    assert store.resolve_first_model_ref(["c/none"]) is None
+
+
+def test_resolve_multimodal_model_ref_respects_allowlist(store: ProviderStore) -> None:
+    _add_provider(store, "a", [_model("text-only"), _model("vision", image=True)])
+    _add_provider(store, "b", [_model("other-vision", image=True)])
+    assert store.resolve_multimodal_model_ref() == "a/vision"
+    assert store.resolve_multimodal_model_ref(["b/other-vision"]) == "b/other-vision"
+    # Whitelist without any vision-capable entry → no upgrade available.
+    assert store.resolve_multimodal_model_ref(["a/text-only"]) is None
+
+
+def test_resolve_model_for_multimodal_turn_allowlist(store: ProviderStore) -> None:
+    _add_provider(store, "a", [_model("text-only"), _model("vision", image=True)])
+    _add_provider(store, "b", [_model("other-vision", image=True)])
+
+    # Text turn: whitelisted ref passes through, non-whitelisted dropped.
+    assert store.resolve_model_for_multimodal_turn("a/text-only", needs_multimodal=False) == (
+        "a/text-only"
+    )
+    assert (
+        store.resolve_model_for_multimodal_turn(
+            "a/text-only", needs_multimodal=False, allowed_models=["b/other-vision"]
+        )
+        is None
+    )
+
+    # Vision turn: whitelisted multimodal ref kept.
+    assert (
+        store.resolve_model_for_multimodal_turn(
+            "a/vision", needs_multimodal=True, allowed_models=["a/vision"]
+        )
+        == "a/vision"
+    )
+    # Vision turn: non-whitelisted text ref is NOT silently upgraded to the
+    # first global vision model; upgrade only happens inside the whitelist.
+    assert (
+        store.resolve_model_for_multimodal_turn(
+            "a/text-only", needs_multimodal=True, allowed_models=["a/vision"]
+        )
+        == "a/vision"
+    )
+    assert (
+        store.resolve_model_for_multimodal_turn(
+            "a/text-only", needs_multimodal=True, allowed_models=["b/other-vision"]
+        )
+        == "b/other-vision"
+    )
+    # Nothing whitelisted is vision-capable and the ref itself is not
+    # whitelisted → None (clear failure, no silent non-whitelist swap).
+    assert (
+        store.resolve_model_for_multimodal_turn(
+            "a/text-only", needs_multimodal=True, allowed_models=["a/text-only"]
+        )
+        is None
+    )
+
+    # No allowlist → official behavior (upgrade to first vision model).
+    assert (
+        store.resolve_model_for_multimodal_turn("a/text-only", needs_multimodal=True) == "a/vision"
+    )
+
+
+def test_resolve_model_for_multimodal_turn_no_allowlist_no_vision_returns_ref(
+    store: ProviderStore,
+) -> None:
+    """ZBS round 4: no allowlist set + no vision model site-wide → original ref.
+
+    Official code returns ``upgraded or ref`` — with no vision model anywhere
+    that falls back to the original ref. Must not become ``None`` (which
+    would reroute to AUTO) when no allowlist is configured.
+    """
+    _add_provider(store, "a", [_model("text-only")])
+    _add_provider(store, "b", [_model("also-text")])
+
+    # Sanity: no vision model exists anywhere.
+    assert store.resolve_multimodal_model_ref() is None
+
+    assert (
+        store.resolve_model_for_multimodal_turn("a/text-only", needs_multimodal=True)
+        == "a/text-only"
+    )
+    # None ref with no allowlist stays None (official behavior).
+    assert store.resolve_model_for_multimodal_turn(None, needs_multimodal=True) is None
+    # Text turns pass through unchanged with no allowlist.
+    assert (
+        store.resolve_model_for_multimodal_turn("a/text-only", needs_multimodal=False)
+        == "a/text-only"
+    )
