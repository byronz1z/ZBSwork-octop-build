+async def test_turn_stops_when_whitelisted_models_unusable(env) -> None:
+    """Auto turn with no usable whitelisted model stops with the localized reason."""
+    import asyncio
+
+    from tests.support.http import chat_ws_path, ws_connect
+
+    c, srv, auth = env
+    await _seed_providers(c, auth)
+    alice = await create_user(c, auth, username="alice")
+    alice_id = await resolve_user_id(c, auth, "alice")
+
+    r = await c.post(
+        "/api/agents",
+        headers=alice,
+        json={"name": "alice-auto", "config": {"providers": ["openai"]}},
+    )
+    assert r.status_code == 201, r.text
+    agent_id = r.json()["agent_id"]
+
+    r = await c.patch(
+        f"/api/users/{alice_id}", headers=auth, json={"allowed_models": ["second/m2"]}
+    )
+    assert r.status_code == 200, r.text
+
+    # Admin disables the only whitelisted model (provider "second" -> m2 off).
+    providers = (await c.get("/api/admin/providers", headers=auth)).json()
+    second = next(row for row in providers if row["name"] == "second")
+    m2 = next(m for m in second["models"] if m["id"] == "m2")
+    r = await c.patch(
+        f"/api/admin/providers/{second['id']}",
+        headers=auth,
+        json={"models": [{**m2, "enabled": False}]},
+    )
+    assert r.status_code == 200, r.text
+
+    # A turn with no explicit model ("auto") must stop with the localized
+    # NO_ALLOWED_MODEL_AVAILABLE reason, not fall back to openai/gpt-4o.
+    async with ws_connect(c._octop_app, chat_ws_path(agent_id, alice)) as ws:
+        await ws.send_json({"type": "user_turn", "text": "hi"})
+        frames = []
+        while True:
+            frame = await asyncio.wait_for(ws.receive_json(), timeout=10)
+            frames.append(frame)
+            if frame.get("type") in ("done", "turn.ended"):
+                break
+    errors = [f for f in frames if f.get("type") == "error"]
+    assert errors, frames
+    assert "你可用的模型当前都无法使用" in errors[0].get("message", "")
+
+
+async def test_cron_stops_when_whitelisted_models_unusable(env) -> None:
