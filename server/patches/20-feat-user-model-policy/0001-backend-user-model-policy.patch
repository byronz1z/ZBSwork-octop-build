+    alice_id = await resolve_user_id(c, auth, "alice")
+
+    r = await c.post(
+        "/api/agents",
+        headers=alice,
+        json={"name": "alice-cron", "config": {"providers": ["openai"]}},
+    )
+    assert r.status_code == 201, r.text
+    agent_id = r.json()["agent_id"]
+
+    r = await c.patch(
+        f"/api/users/{alice_id}", headers=auth, json={"allowed_models": ["second/m2"]}
+    )
+    assert r.status_code == 200, r.text
+
+    r = await c.post(
+        f"/api/agents/{agent_id}/cron",
+        headers=alice,
+        json={"name": "auto", "prompt": "hi", "trigger": "interval:60", "task_type": "agent"},
+    )
+    assert r.status_code == 201, r.text
+    cron_id = r.json()["id"]
+
+    providers = (await c.get("/api/admin/providers", headers=auth)).json()
+    second = next(row for row in providers if row["name"] == "second")
+    m2 = next(m for m in second["models"] if m["id"] == "m2")
+    r = await c.patch(
+        f"/api/admin/providers/{second['id']}",
+        headers=auth,
+        json={"models": [{**m2, "enabled": False}]},
+    )
+    assert r.status_code == 200, r.text
+
+    r = await c.post(f"/api/agents/{agent_id}/cron/{cron_id}/run-now", headers=alice)
+    assert r.status_code == 204, r.text
+
+    # The run must be recorded as failed with the localized reason.
+    import time
+
+    row = None
+    for _ in range(50):
+        jobs = (await c.get(f"/api/agents/{agent_id}/cron", headers=alice)).json()
+        row = next(j for j in jobs if j["id"] == cron_id)
+        if row.get("last_status"):
+            break
+        time.sleep(0.2)
+    assert row is not None and row["last_status"] == "error", row
+    assert "你可用的模型当前都无法使用" in (row.get("last_error") or ""), row
