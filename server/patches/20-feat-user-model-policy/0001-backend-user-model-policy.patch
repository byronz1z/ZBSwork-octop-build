+++ b/tests/unit/agents/test_memory_model_policy.py
@@ -0,0 +1,176 @@
+"""ZBS patch 20 (feature 4): memory distillation respects the owner's model whitelist.
+
+Covers ``AgentManager._build_harness_config``:
+
+- whitelisted owner: harness ``default_model`` picked inside the whitelist
+  (pinned explicit default when whitelisted, else whitelist-restricted fallback);
+- whitelisted owner, no usable whitelisted model: ``memory_aux_model_enabled``
+  is switched off instead of falling back to a non-whitelisted model
+  (harness ``pick_default_model_ref`` would otherwise pick the first enabled
+  model of ANY provider);
+- non-whitelisted ``memory.aux_model`` override is dropped so extraction
+  cannot escape the whitelist via the aux tier;
+- no whitelist / admin owner: official behavior unchanged.
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+
+from octop.config import OctopConfig
+from octop.infra.agents.manager import AgentManager
+from octop.infra.db.migrate import run_migrations
+from octop.infra.db.pool import SqlitePool
+from octop.infra.db.repos.agents import AgentRow
+from octop.infra.db.services import build_shared_services
+from octop.infra.utils.paths import PathLayout
+
+
+@pytest.fixture
+def manager(tmp_path: Path) -> AgentManager:
+    paths = PathLayout(tmp_path / ".octop")
+    paths.ensure_root()
+    db = SqlitePool(paths.db)
+    run_migrations(db)
+    services = build_shared_services(db=db, paths=paths, config=OctopConfig())
+    return AgentManager(repos=services.repos, paths=services.paths)
+
+
+def _add_provider(manager: AgentManager, name: str, models: list[str]) -> None:
+    manager._repos.provider_repo.create(
+        name=name,
+        kind="openai",
+        base_url=f"https://{name}.example/v1",
+        api_key=f"sk-{name}",
+        models_json=json.dumps(
+            [
+                {"id": mid, "name": mid, "enabled": True, "input": ["text"], "thinking": False}
+                for mid in models
+            ]
+        ),
+    )
+
+
+def _seed_user(manager: AgentManager, *, role: str, name: str = "alice") -> int:
+    return manager._repos.user_repo.create(username=name, role=role, password_hash=None)
+
+
+def _row(
+    user_id: int, config_json: str | None = None, default_model: str | None = None
+) -> AgentRow:
+    return AgentRow(
+        id=1,
+        agent_id="01AGENT",
+        user_id=user_id,
+        name="bot",
+        description=None,
+        persona_mbti=None,
+        default_model=default_model,
+        system_prompt=None,
+        enabled=1,
+        config_json=config_json,
+        last_state=None,
+        last_error=None,
+        created_at=0,
+        updated_at=0,
+    )
+
+
+def test_whitelisted_owner_gets_whitelisted_default_model(manager: AgentManager) -> None:
+    _add_provider(manager, "a", ["m1", "m2"])
+    _add_provider(manager, "b", ["m3"])
+    manager._repos.settings_repo.set_active_model("b", "m3")  # site-wide default
+    uid = _seed_user(manager, role="user")
+    manager._repos.user_policy_repo.set(uid, "allowed_models", json.dumps(["a/m2"]))
+
+    cfg = manager._build_harness_config(_row(uid))
+
+    assert cfg.default_model == "a/m2"  # inside the whitelist, not b/m3
+    assert cfg.memory_aux_model_enabled is True
+    assert cfg.memory_aux_light_model is None
+
+
+def test_whitelisted_owner_pinned_default_outside_whitelist_falls_back_inside(
+    manager: AgentManager,
+) -> None:
+    _add_provider(manager, "a", ["m1"])
+    _add_provider(manager, "b", ["m3"])
+    uid = _seed_user(manager, role="user")
+    manager._repos.user_policy_repo.set(uid, "allowed_models", json.dumps(["a/m1"]))
+
+    cfg = manager._build_harness_config(_row(uid, default_model="b/m3"))
+
+    assert cfg.default_model == "a/m1"
+
+
+def test_whitelisted_owner_no_usable_model_disables_memory_distillation(
+    manager: AgentManager,
+) -> None:
+    _add_provider(manager, "a", ["m1"])
+    _add_provider(manager, "b", ["m3"])
+    uid = _seed_user(manager, role="user")
+    # Whitelist points only at a provider that does not exist.
+    manager._repos.user_policy_repo.set(uid, "allowed_models", json.dumps(["x/none"]))
+
+    cfg = manager._build_harness_config(_row(uid))
+
+    assert cfg.default_model is None
+    assert cfg.memory_aux_model_enabled is False
+
+
+def test_whitelisted_owner_non_whitelisted_aux_model_dropped(manager: AgentManager) -> None:
+    _add_provider(manager, "a", ["m1"])
+    _add_provider(manager, "b", ["m3"])
+    uid = _seed_user(manager, role="user")
+    manager._repos.user_policy_repo.set(uid, "allowed_models", json.dumps(["a/m1"]))
+    config_json = json.dumps({"memory": {"aux_model": "b/m3"}})
+
+    cfg = manager._build_harness_config(_row(uid, config_json=config_json))
+
+    assert cfg.default_model == "a/m1"
+    assert cfg.memory_aux_light_model is None
+    assert cfg.memory_aux_heavy_model is None
+    assert cfg.memory_aux_model_enabled is True
+
+
+def test_whitelisted_owner_whitelisted_aux_model_kept(manager: AgentManager) -> None:
+    _add_provider(manager, "a", ["m1"])
+    uid = _seed_user(manager, role="user")
+    manager._repos.user_policy_repo.set(uid, "allowed_models", json.dumps(["a/m1"]))
+    config_json = json.dumps({"memory": {"aux_model": "a/m1"}})
+
+    cfg = manager._build_harness_config(_row(uid, config_json=config_json))
+
+    assert cfg.memory_aux_light_model == "a/m1"
+    assert cfg.memory_aux_heavy_model == "a/m1"
+
+
+def test_no_whitelist_owner_behavior_unchanged(manager: AgentManager) -> None:
+    _add_provider(manager, "a", ["m1"])
+    _add_provider(manager, "b", ["m3"])
+    manager._repos.settings_repo.set_active_model("b", "m3")
+    uid = _seed_user(manager, role="user")
+
+    cfg = manager._build_harness_config(_row(uid))
+
+    assert cfg.default_model == "b/m3"  # official: site-wide active model
+    assert cfg.memory_aux_model_enabled is True
+
+
+def test_admin_owner_behavior_unchanged_even_with_whitelist_entry(
+    manager: AgentManager,
+) -> None:
+    _add_provider(manager, "a", ["m1"])
+    _add_provider(manager, "b", ["m3"])
+    manager._repos.settings_repo.set_active_model("b", "m3")
+    uid = _seed_user(manager, role="admin")
+    # Admins are never restricted; a stale policy row must not apply.
+    manager._repos.user_policy_repo.set(uid, "allowed_models", json.dumps(["a/m1"]))
+
+    cfg = manager._build_harness_config(_row(uid))
+
+    assert cfg.default_model == "b/m3"
+    assert cfg.memory_aux_model_enabled is True
