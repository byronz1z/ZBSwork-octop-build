@@ -0,0 +1,155 @@
+"""ZBS patch 20 — `_resolve_harness_model` allowlist filtering (F8 main chain)."""
+
+from __future__ import annotations
+
+import json
+from typing import Any
+from unittest.mock import MagicMock
+
+import pytest
+
+from octop.infra.errors import ErrorCode, OctopError
+from octop.infra.gateway.process.processor import GlobalProcessor
+from octop.infra.users.resource_policy import POLICY_ALLOWED_MODELS
+
+
+def _processor(
+    *,
+    allowed_models: list[str] | None,
+    preferred_model: str | None = None,
+    agent_default_model: str | None = None,
+    is_admin: bool = False,
+) -> GlobalProcessor:
+    processor = GlobalProcessor(
+        agent_manager=MagicMock(),
+        thread_registry=MagicMock(),
+        audit_repo=MagicMock(),
+        agent_repo=MagicMock(),
+        user_repo=MagicMock(),
+        connector_repo=MagicMock(),
+        dispatcher=MagicMock(),
+        usage_repo=MagicMock(),
+        gateway=MagicMock(),
+    )
+    processor._agent_manager.get_thread_model.return_value = None
+    processor._thread_registry.get_thread.return_value = None
+    processor._agent_repo.get.return_value = MagicMock(default_model=agent_default_model)
+    processor._agent_manager.get_config.return_value = {}
+
+    providers = processor._agent_manager.providers
+    providers.is_model_ref_usable.side_effect = lambda ref: True
+    providers.resolve_explicit_default_model.side_effect = (
+        None if agent_default_model is None else lambda row, cfg: agent_default_model
+    )
+    # Pass-through unless the test overrides it.
+    providers.resolve_model_for_multimodal_turn.side_effect = (
+        lambda ref, *, needs_multimodal, allowed_models=None: (
+            ref if allowed_models is None or ref in allowed_models else None
+        )
+    )
+
+    user_row = MagicMock(preferences_json="{}")
+    if preferred_model is not None:
+        user_row.preferences_json = json.dumps({"preferred_model": preferred_model})
+    user_row.role = "admin" if is_admin else "user"
+    processor._user_repo.get.return_value = user_row
+
+    class _Policies:
+        def __init__(self, refs: list[str] | None) -> None:
+            self._raw = None if refs is None else json.dumps(refs)
+
+        def get(self, user_id: int, name: str) -> Any:
+            if name == POLICY_ALLOWED_MODELS and self._raw is not None:
+                return MagicMock(value=self._raw, enabled=True)
+            return None
+
+    repos = MagicMock()
+    repos.user_policy_repo = _Policies(allowed_models)
+    processor._agent_manager._repos = repos
+
+    processor._agent_manager.resolve_fallback_model_ref.side_effect = lambda allowed=None: (
+        "fallback/model" if allowed is None or "fallback/model" in allowed else None
+    )
+    return processor
+
+
+def test_no_policy_official_behavior() -> None:
+    """No allowed_models policy → every priority level works as official."""
+    p = _processor(allowed_models=None)
+    # Dashboard override passes through.
+    assert (
+        p._resolve_harness_model("a1", "t1", {"model": "any/picked"}, needs_multimodal=False)
+        == "any/picked"
+    )
+
+
+def test_override_outside_allowlist_falls_to_agent_default() -> None:
+    """Composer pick outside the whitelist is dropped; agent default inside wins."""
+    p = _processor(allowed_models=["p/ok"], agent_default_model="p/ok")
+    resolved = p._resolve_harness_model("a1", "t1", {"model": "p/bad"}, needs_multimodal=False)
+    assert resolved == "p/ok"
+
+
+def test_agent_default_outside_allowlist_falls_to_preferred() -> None:
+    p = _processor(allowed_models=["p/ok"], agent_default_model="p/bad", preferred_model="p/ok")
+    resolved = p._resolve_harness_model("a1", "t1", None, needs_multimodal=False)
+    assert resolved == "p/ok"
+
+
+def test_fallback_respects_allowlist() -> None:
+    p = _processor(allowed_models=["fallback/model"])
+    # No higher priority resolves; fallback inside the whitelist is used.
+    resolved = p._resolve_harness_model("a1", "t1", None, needs_multimodal=False)
+    assert resolved == "fallback/model"
+
+
+def test_no_whitelisted_model_usable_raises_no_allowed_model() -> None:
+    """Nothing in the whitelist resolves → NO_ALLOWED_MODEL_AVAILABLE (clear stop)."""
+    p = _processor(allowed_models=["p/none"], preferred_model="p/other")
+    with pytest.raises(OctopError) as exc:
+        p._resolve_harness_model("a1", "t1", None, needs_multimodal=False)
+    assert exc.value.code is ErrorCode.NO_ALLOWED_MODEL_AVAILABLE
+    assert exc.value.status == 403
+
+
+def test_no_policy_none_still_means_harness_auto() -> None:
+    """Without a whitelist a failed resolution still returns None (official AUTO)."""
+    p = _processor(allowed_models=None, agent_default_model=None, preferred_model="p/gone")
+    providers = p._agent_manager.providers
+    providers.resolve_explicit_default_model.return_value = None
+    p._user_repo.get.return_value = MagicMock(preferences_json="{}")
+    p._agent_manager.resolve_fallback_model_ref.side_effect = lambda allowed=None: None
+    assert p._resolve_harness_model("a1", "t1", None, needs_multimodal=False) is None
+
+
+def test_multimodal_upgrade_receives_allowlist() -> None:
+    p = _processor(allowed_models=["p/ok"])
+    providers = p._agent_manager.providers
+    providers.resolve_model_for_multimodal_turn.side_effect = None
+    providers.resolve_model_for_multimodal_turn.return_value = "p/ok"
+    resolved = p._resolve_harness_model("a1", "t1", {"model": "p/ok"}, needs_multimodal=True)
+    assert resolved == "p/ok"
+    providers.resolve_model_for_multimodal_turn.assert_called_once_with(
+        "p/ok",
+        needs_multimodal=True,
+        allowed_models=["p/ok"],
+    )
+
+
+def test_multimodal_upgrade_blocked_by_allowlist_raises() -> None:
+    """Whitelist set and the vision upgrade picks nothing → NO_ALLOWED_MODEL_AVAILABLE."""
+    p = _processor(allowed_models=["p/ok"])
+    providers = p._agent_manager.providers
+    providers.resolve_model_for_multimodal_turn.side_effect = (
+        lambda ref, *, needs_multimodal, allowed_models=None: None
+    )
+    with pytest.raises(OctopError) as exc:
+        p._resolve_harness_model("a1", "t1", {"model": "p/ok"}, needs_multimodal=True)
+    assert exc.value.code is ErrorCode.NO_ALLOWED_MODEL_AVAILABLE
+
+
+def test_admin_policy_row_is_ignored() -> None:
+    """A stray policy row on an admin user does not restrict (whitelist reads None)."""
+    p = _processor(allowed_models=["p/only"], is_admin=True)
+    # _allowed_models_for_user returns None for admins even with a row.
+    assert p._allowed_models_for_user(1) is None
