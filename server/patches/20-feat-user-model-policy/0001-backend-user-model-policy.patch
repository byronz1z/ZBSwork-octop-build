@@ -0,0 +1,121 @@
+"""ZBS patch 20 — allowed_models policy primitives (F7)."""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+
+from octop.infra.db.migrate import run_migrations
+from octop.infra.db.pool import SqlitePool
+from octop.infra.db.repos.user_policies import UserPolicyRepo
+from octop.infra.db.repos.users import UserRepo
+from octop.infra.errors import ErrorCode, OctopError
+from octop.infra.users.resource_policy import (
+    POLICY_ALLOWED_MODELS,
+    allowed_models_for_user,
+    allowed_models_for_user_id,
+    allowed_models_json,
+    allowed_models_of,
+    assert_model_allowed_for_user,
+    model_ref_is_allowed,
+    normalize_allowed_models,
+    public_policy_fields,
+)
+
+
+@pytest.fixture
+def db(tmp_path: Path) -> SqlitePool:
+    pool = SqlitePool(tmp_path / "octop.db")
+    run_migrations(pool)
+    return pool
+
+
+def test_allowed_models_of_various_shapes() -> None:
+    assert allowed_models_of(None) is None
+    assert allowed_models_of("") is None
+    assert allowed_models_of('["openai/gpt-4o"]') == ["openai/gpt-4o"]
+    # disabled row reads as unrestricted
+    from octop.infra.users.resource_policy import active_policy_value  # noqa: F401
+
+    assert allowed_models_of({"value": '["a/b"]', "enabled": False}) is None
+    # malformed rows read as unrestricted
+    assert allowed_models_of("not-json") is None
+    assert allowed_models_of('{"x": 1}') is None
+    # blank entries dropped; an all-blank list reads as unrestricted
+    assert allowed_models_of('["a/b", "", "c/d"]') == ["a/b", "c/d"]
+    assert allowed_models_of('["", ""]') is None
+
+
+def test_normalize_allowed_models() -> None:
+    assert normalize_allowed_models(None) is None
+    assert normalize_allowed_models([]) is None
+    assert normalize_allowed_models(["openai/gpt-4o", "openai/gpt-4o"]) == ["openai/gpt-4o"]
+    with pytest.raises(OctopError) as exc:
+        normalize_allowed_models(["gpt-4o"])
+    assert exc.value.code is ErrorCode.FORBIDDEN
+    with pytest.raises(OctopError):
+        normalize_allowed_models(["/gpt-4o"])
+    with pytest.raises(OctopError):
+        normalize_allowed_models(["openai/"])
+    # Model ids containing "/" pass (first "/" splits provider/model).
+    assert normalize_allowed_models(["a/b/c"]) == ["a/b/c"]
+    assert normalize_allowed_models(["Aliyun api/ZHIPU/GLM-5.3-Flash"]) == [
+        "Aliyun api/ZHIPU/GLM-5.3-Flash"
+    ]
+
+
+def test_allowed_models_json_roundtrip() -> None:
+    refs = ["openai/gpt-4o", "deepseek/deepseek-chat"]
+    stored = allowed_models_json(refs)
+    assert stored == '["openai/gpt-4o", "deepseek/deepseek-chat"]'
+    assert allowed_models_of(stored) == refs
+    assert allowed_models_json(None) is None
+
+
+def test_public_policy_fields_includes_allowed_models() -> None:
+    fields = public_policy_fields({"allowed_models": '["a/b"]'})
+    assert fields["allowed_models"] == ["a/b"]
+    assert fields["token_quota"] is None
+    fields_empty = public_policy_fields(None)
+    assert fields_empty["allowed_models"] is None
+
+
+def test_allowed_models_for_user_admin_never_restricted(db: SqlitePool) -> None:
+    users = UserRepo(db)
+    uid = users.create(username="root", password_hash="h", role="admin")
+    policies = UserPolicyRepo(db)
+    policies.set(uid, POLICY_ALLOWED_MODELS, '["openai/gpt-4o"]')
+    row = users.get(uid)
+    # Admin rows are never restricted even if a stray policy row exists.
+    assert allowed_models_for_user(row) is None
+    assert allowed_models_for_user_id(policies, users, uid) is None
+
+
+def test_allowed_models_for_user_id_and_assert(db: SqlitePool) -> None:
+    users = UserRepo(db)
+    policies = UserPolicyRepo(db)
+    uid = users.create(username="alice", password_hash="h", role="user")
+
+    # No policy → unrestricted.
+    assert allowed_models_for_user_id(policies, users, uid) is None
+    assert_model_allowed_for_user(policies, users, uid, "any/model")
+
+    policies.set(uid, POLICY_ALLOWED_MODELS, '["openai/gpt-4o","deepseek/deepseek-chat"]')
+    assert allowed_models_for_user_id(policies, users, uid) == [
+        "openai/gpt-4o",
+        "deepseek/deepseek-chat",
+    ]
+    assert_model_allowed_for_user(policies, users, uid, "openai/gpt-4o")
+    with pytest.raises(OctopError) as exc:
+        assert_model_allowed_for_user(policies, users, uid, "anthropic/claude-4")
+    assert exc.value.code is ErrorCode.MODEL_NOT_ALLOWED
+    assert exc.value.status == 403
+    assert exc.value.details["model"] == "anthropic/claude-4"
+
+
+def test_model_ref_is_allowed() -> None:
+    assert model_ref_is_allowed("a/b", None)
+    assert model_ref_is_allowed("a/b", ["a/b"])
+    assert not model_ref_is_allowed("a/c", ["a/b"])
+    assert not model_ref_is_allowed("", ["a/b"])
