+# --- ZT-018 / 60-svc-runtime-extras: user tools actually used in production (evidence in patch dir README) ---
+# system python (/usr/local/bin/python3, python:3.12-slim ships pip): 12 pinned packages;
+# app venv /app/.venv is created by uv without pip, install 2 packages via uv pip.
+RUN --mount=type=cache,target=/root/.cache/uv \
+    --mount=type=cache,target=/root/.cache/pip \
+    if [ -n "$PIP_INDEX_URL" ]; then \
+        export UV_INDEX_URL="$PIP_INDEX_URL"; \
+        if [ -n "$PIP_TRUSTED_HOST" ]; then export UV_INSECURE_HOST="$PIP_TRUSTED_HOST"; fi; \
+    fi \
+    && /usr/local/bin/python3 -m pip install --no-cache-dir \
+        cairosvg==2.9.1 jieba==0.42.1 markdown==3.11 openpyxl==3.1.5 pandas==3.0.6 \
+        send2trash==2.1.0 olefile==0.47 matplotlib==3.11.2 xlrd==2.0.2 \
+        rapidocr_onnxruntime==1.4.4 vtracer==0.6.15 python_docx==1.2.0 \
+    && uv pip install --python /app/.venv/bin/python \
+        pandas==3.0.6 rapidocr_onnxruntime==1.4.4
+
 RUN mkdir -p /data/.octop
 
 EXPOSE 8088
