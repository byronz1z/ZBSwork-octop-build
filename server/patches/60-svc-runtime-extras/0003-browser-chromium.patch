diff --git a/docker/Dockerfile b/docker/Dockerfile
index 1c0e72df06074003fe55d754ab9571bc6c015c68..ade658d9f53fea718ccb664d80b9f0f5adcb92be 100644
--- a/docker/Dockerfile
+++ b/docker/Dockerfile
@@ -187,6 +187,18 @@ RUN --mount=type=cache,target=/root/.cache/uv \
 
 RUN mkdir -p /data/.octop
 
+# --- ZT-026 / 60-svc-runtime-extras 0003: browser binary into the image ---
+# Official installs the browser *libraries* (uv sync --extra browser brings
+# the playwright package; the apt layer carries the shared libs + CJK fonts)
+# but never the Chromium binary itself — browser_use then fails with
+# "Chrome/Chromium not found". octop_browser.cdp.launcher.find_chrome()
+# discovers Playwright's download cache, and this Dockerfile already exports
+# PLAYWRIGHT_BROWSERS_PATH=/root/.cache/ms-playwright, so the official
+# installer command (`playwright install chromium`; headless mode needs no
+# DISPLAY) is the most upstream-faithful install: if a future official image
+# ships a browser at the same cache layout, the installer becomes a no-op.
+RUN /app/.venv/bin/python -m playwright install chromium
+
 EXPOSE 8088
 
 HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=3 \
