diff --git a/tests/unit/test_launch_ws_ping.py b/tests/unit/test_launch_ws_ping.py
new file mode 100644
index 0000000000000000000000000000000000000000..a83fabfc6d8a632d2ad35af5088b9a0ee178478a
--- /dev/null
+++ b/tests/unit/test_launch_ws_ping.py
@@ -0,0 +1,217 @@
+"""Tests for WebSocket keepalive ping timeout configuration in ``octop.launch``."""
+
+from __future__ import annotations
+
+import importlib
+import sys
+from pathlib import Path
+from types import ModuleType, SimpleNamespace
+from typing import Any
+
+import pytest
+import uvicorn
+
+EXPECTED_WS_MAX_BYTES = 64 * 1024 * 1024
+
+
+def _load_launch_module(monkeypatch: pytest.MonkeyPatch) -> ModuleType:
+    """Import real ``octop.launch``; stub transitive runtime deps only when absent."""
+    try:
+        importlib.import_module("octop.infra.bridge.transport")
+        return importlib.import_module("octop.launch")
+    except ModuleNotFoundError:
+        pass
+
+    # Lightweight host test environment without full server wheels (e.g. octop-harness):
+    # keep real ``octop.launch`` + ``uvicorn.Config`` execution while stubbing
+    # only the transitive modules that ``run_foreground`` mocks out anyway.
+    class _PlaceholderServer:
+        pass
+
+    stub_modules: dict[str, dict[str, Any]] = {
+        "octop.infra.server": {"OctopServer": _PlaceholderServer},
+        "octop.api": {},
+        "octop.api.app": {"build_app": lambda _srv: None},
+        "octop.infra.bridge": {},
+        "octop.infra.bridge.transport": {
+            "BRIDGE_WS_MAX_BYTES": EXPECTED_WS_MAX_BYTES,
+        },
+        "octop.infra.setup": {},
+        "octop.infra.setup.tls": {},
+        "octop.infra.setup.tls.http_companion": {
+            "build_http_companion_app": lambda https_port: None,
+        },
+        "octop.infra.setup.tls.listeners": {
+            "build_listen_plan": lambda *a, **kw: None,
+        },
+        "octop.infra.setup.tls.store": {
+            "resolve_tls_paths": lambda _root, _tls: (None, None),
+        },
+        "octop.infra.agents": {},
+        "octop.infra.agents.memory": {},
+        "octop.infra.agents.memory.slim_control": {
+            "MemorySlimControl": object,
+        },
+    }
+    for name, attrs in stub_modules.items():
+        if name not in sys.modules:
+            mod = ModuleType(name)
+            for k, v in attrs.items():
+                setattr(mod, k, v)
+            monkeypatch.setitem(sys.modules, name, mod)
+
+    monkeypatch.delitem(sys.modules, "octop.launch", raising=False)
+    return importlib.import_module("octop.launch")
+
+
+def _install_launch_fakes(
+    monkeypatch: pytest.MonkeyPatch,
+    *,
+    dual_listeners: bool,
+) -> tuple[ModuleType, list[uvicorn.Config], int]:
+    launch = _load_launch_module(monkeypatch)
+    transport = importlib.import_module("octop.infra.bridge.transport")
+    ws_max_bytes: int = transport.BRIDGE_WS_MAX_BYTES
+
+    captured_configs: list[uvicorn.Config] = []
+
+    class FakeServer:
+        def __init__(self, config: uvicorn.Config) -> None:
+            self.config = config
+            captured_configs.append(config)
+
+        async def serve(self) -> None:
+            return None
+
+    class FakeOctopServer:
+        def __init__(self) -> None:
+            self.services = None
+            self.paths = SimpleNamespace(root=Path("/tmp/octop-test"))
+            self.config = SimpleNamespace(
+                bind_host="127.0.0.1",
+                port=8787,
+                log_level="info",
+                tls=SimpleNamespace(),
+            )
+
+        async def start(self) -> None:
+            return None
+
+        async def stop(self) -> None:
+            return None
+
+    class FakeMemorySlimControl:
+        def __init__(self, _srv: Any) -> None:
+            pass
+
+        async def start(self) -> None:
+            return None
+
+        async def close(self) -> None:
+            return None
+
+    async def dummy_app(scope: Any, receive: Any, send: Any) -> None:
+        return None
+
+    plan = (
+        SimpleNamespace(
+            dual_listeners=True,
+            bind_host="0.0.0.0",
+            https_port=8443,
+            http_port=8080,
+            ssl_certfile="/tmp/cert.pem",
+            ssl_keyfile="/tmp/key.pem",
+        )
+        if dual_listeners
+        else SimpleNamespace(
+            dual_listeners=False,
+            bind_host="127.0.0.1",
+            https_port=None,
+            http_port=8787,
+            ssl_certfile=None,
+            ssl_keyfile=None,
+        )
+    )
+
+    monkeypatch.setattr(launch, "OctopServer", FakeOctopServer)
+    monkeypatch.setattr(launch, "_schedule_linux_bubblewrap_ensure", lambda: None)
+    monkeypatch.setattr(uvicorn, "Server", FakeServer)
+    monkeypatch.setattr(
+        importlib.import_module("octop.api.app"),
+        "build_app",
+        lambda _srv: dummy_app,
+    )
+    monkeypatch.setattr(
+        importlib.import_module("octop.infra.setup.tls.http_companion"),
+        "build_http_companion_app",
+        lambda https_port: dummy_app,
+    )
+    monkeypatch.setattr(
+        importlib.import_module("octop.infra.setup.tls.listeners"),
+        "build_listen_plan",
+        lambda *args, **kwargs: plan,
+    )
+    monkeypatch.setattr(
+        importlib.import_module("octop.infra.setup.tls.store"),
+        "resolve_tls_paths",
+        lambda _root, _tls: (None, None),
+    )
+    monkeypatch.setattr(
+        importlib.import_module("octop.infra.agents.memory.slim_control"),
+        "MemorySlimControl",
+        FakeMemorySlimControl,
+    )
+    return launch, captured_configs, ws_max_bytes
+
+
+def test_ws_ping_timeout_constant_disabled(monkeypatch: pytest.MonkeyPatch) -> None:
+    launch = _load_launch_module(monkeypatch)
+    assert launch.WS_PING_TIMEOUT is None
+
+
+@pytest.mark.asyncio
+async def test_single_listener_disables_ws_ping_timeout(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    launch, configs, ws_max_bytes = _install_launch_fakes(
+        monkeypatch, dual_listeners=False
+    )
+
+    await launch.run_foreground(
+        host=None,
+        port=None,
+        reload=False,
+        workers=1,
+        log_level="info",
+        ssl_certfile=None,
+        ssl_keyfile=None,
+    )
+
+    assert len(configs) == 1
+    assert configs[0].ws_ping_timeout is None
+    assert configs[0].ws_max_size == ws_max_bytes
+
+
+@pytest.mark.asyncio
+async def test_dual_listener_https_disables_ws_ping_timeout(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    launch, configs, ws_max_bytes = _install_launch_fakes(
+        monkeypatch, dual_listeners=True
+    )
+
+    await launch.run_foreground(
+        host=None,
+        port=None,
+        reload=False,
+        workers=1,
+        log_level="info",
+        ssl_certfile="/tmp/cert.pem",
+        ssl_keyfile="/tmp/key.pem",
+    )
+
+    assert len(configs) == 2
+    https_cfg = configs[0]
+    assert https_cfg.port == 8443
+    assert https_cfg.ws_ping_timeout is None
+    assert https_cfg.ws_max_size == ws_max_bytes
