@@ -0,0 +1,101 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { BOOT_FALLBACK_ID, renderBootFallback } from "./bootFallback";
+import {
+  CHUNK_RECOVERY_BANNER_ID,
+  clearChunkReloadFlag,
+  renderChunkRecoveryBanner,
+} from "./reloadOnStaleChunk";
+
+function stubReload() {
+  const reload = vi.fn();
+  Object.defineProperty(window, "location", {
+    configurable: true,
+    value: { reload },
+  });
+  return reload;
+}
+
+describe("renderBootFallback", () => {
+  let reload: ReturnType<typeof vi.fn>;
+
+  beforeEach(() => {
+    document.body.innerHTML = '<div id="root"><div id="octop-boot">加载中…</div></div>';
+    sessionStorage.clear();
+    clearChunkReloadFlag();
+    reload = stubReload();
+  });
+
+  afterEach(() => {
+    clearChunkReloadFlag();
+    document.body.innerHTML = "";
+    vi.restoreAllMocks();
+  });
+
+  it("replaces #root boot splash with Chinese fallback UI and reload button", async () => {
+    renderBootFallback(new Error("i18n bundle fetch failed"));
+
+    expect(document.getElementById("octop-boot")).toBeNull();
+    const fallback = document.getElementById(BOOT_FALLBACK_ID);
+    expect(fallback).not.toBeNull();
+    expect(fallback?.textContent).toContain("页面初始化失败");
+    expect(fallback?.textContent).toContain("i18n bundle fetch failed");
+
+    const btn = fallback?.querySelector("button");
+    expect(btn?.textContent).toBe("重新加载");
+    btn?.click();
+    await vi.waitFor(() => expect(reload).toHaveBeenCalledOnce());
+  });
+
+  it("escapes error detail safely via textContent (no HTML injection)", () => {
+    renderBootFallback(new Error('<img src=x onerror="alert(1)">'));
+    const fallback = document.getElementById(BOOT_FALLBACK_ID);
+    expect(fallback?.querySelector("img")).toBeNull();
+    expect(fallback?.textContent).toContain('<img src=x onerror="alert(1)">');
+  });
+
+  it("removes duplicate chunk-recovery banner when full boot fallback renders", () => {
+    renderChunkRecoveryBanner();
+    expect(document.getElementById(CHUNK_RECOVERY_BANNER_ID)).not.toBeNull();
+
+    renderBootFallback(new Error("init failed"));
+    expect(document.getElementById(CHUNK_RECOVERY_BANNER_ID)).toBeNull();
+    expect(document.getElementById(BOOT_FALLBACK_ID)).not.toBeNull();
+  });
+
+  it("triggers fallback page from main.tsx when initI18n rejects", async () => {
+    vi.resetModules();
+    const errorSpy = vi
+      .spyOn(console, "error")
+      .mockImplementation(() => undefined);
+    vi.doMock("../i18n", () => ({
+      initI18n: () => Promise.reject(new Error("network down")),
+    }));
+    vi.doMock("../App.tsx", () => ({
+      default: () => null,
+    }));
+    vi.doMock("../sw-register", () => ({
+      registerSW: vi.fn(),
+    }));
+    vi.doMock("../pwa-prompt", () => ({}));
+
+    try {
+      await import("../main");
+      await vi.waitFor(() => {
+        expect(document.getElementById(BOOT_FALLBACK_ID)).not.toBeNull();
+      });
+      expect(document.getElementById(BOOT_FALLBACK_ID)?.textContent).toContain(
+        "页面初始化失败",
+      );
+      expect(document.getElementById(BOOT_FALLBACK_ID)?.textContent).toContain(
+        "network down",
+      );
+    } finally {
+      errorSpy.mockRestore();
+      vi.doUnmock("../i18n");
+      vi.doUnmock("../App.tsx");
+      vi.doUnmock("../sw-register");
+      vi.doUnmock("../pwa-prompt");
+      vi.resetModules();
+    }
+  });
+});
