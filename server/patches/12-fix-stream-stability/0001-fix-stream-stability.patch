+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import {
+  STREAM_PAINT_MS,
+  appendUserMessage,
+  cancelStream,
+  getSnapshot,
+  ingestHarnessChunk,
+  removeSession,
+  sendTurn,
+  setHistoryPage,
+  subscribe,
+  type ChatMessage,
+} from "./chatStore";
+
+const SESSION = "test-stream-stability";
+
+function makeMessage(id: string, content: string): ChatMessage {
+  return {
+    id,
+    role: "user",
+    content,
+    timestamp: Date.now(),
+  };
+}
+
+describe("chatStore streaming frame coalescing", () => {
+  beforeEach(() => {
+    vi.useFakeTimers();
+    vi.setSystemTime(new Date("2026-11-27T10:00:00.000Z"));
+  });
+
+  afterEach(() => {
+    removeSession(SESSION);
+    vi.useRealTimers();
+    vi.unstubAllGlobals();
+  });
+
+  it("coalesces rapid streaming deltas into at most one paint per STREAM_PAINT_MS", () => {
+    expect(STREAM_PAINT_MS).toBe(50);
+
+    const listener = vi.fn();
+    const unsub = subscribe(SESSION, listener);
+    try {
+      // First token paints on leading edge (zero added TTFT latency).
+      ingestHarnessChunk(SESSION, { type: "token", content: "A" });
+      expect(listener).toHaveBeenCalledTimes(1);
+      expect(getSnapshot(SESSION).messages[0]?.content).toBe("A");
+
+      // Burst of 10 deltas within the same 50ms window must coalesce.
+      for (let i = 0; i < 10; i++) {
+        vi.advanceTimersByTime(3);
+        ingestHarnessChunk(SESSION, { type: "token", content: String(i) });
+      }
+      expect(listener).toHaveBeenCalledTimes(1);
+      expect(getSnapshot(SESSION).messages[0]?.content).toBe("A");
+
+      // Advancing to the 50ms boundary flushes all 10 deltas in one paint.
+      vi.advanceTimersByTime(20);
+      expect(listener).toHaveBeenCalledTimes(2);
+      expect(getSnapshot(SESSION).messages[0]?.content).toBe("A0123456789");
+
+      // No extra trailing paint when idle.
+      vi.advanceTimersByTime(200);
+      expect(listener).toHaveBeenCalledTimes(2);
+    } finally {
+      unsub();
+    }
+  });
+
+  it("flushes immediately on done without dropping the tail characters", () => {
+    const listener = vi.fn();
+    const unsub = subscribe(SESSION, listener);
+    try {
+      ingestHarnessChunk(SESSION, { type: "token", content: "你好" });
+      expect(listener).toHaveBeenCalledTimes(1);
+
+      vi.advanceTimersByTime(10);
+      ingestHarnessChunk(SESSION, { type: "token", content: "，世界" });
+      ingestHarnessChunk(SESSION, { type: "token", content: "！" });
+      // Still within 50ms window — throttled.
+      expect(listener).toHaveBeenCalledTimes(1);
+
+      // Terminal done must flush immediately with all pending tail tokens.
+      ingestHarnessChunk(SESSION, { type: "done" });
+      expect(listener).toHaveBeenCalledTimes(2);
+      const snap = getSnapshot(SESSION);
+      expect(snap.messages[0]?.content).toBe("你好，世界！");
+      expect(snap.messages[0]?.status).toBe("done");
+
+      // Pending timer was cancelled — advancing timers must not fire again.
+      vi.advanceTimersByTime(100);
+      expect(listener).toHaveBeenCalledTimes(2);
+    } finally {
+      unsub();
+    }
+  });
+
+  it("flushes immediately on error without losing buffered tail text", () => {
+    const listener = vi.fn();
+    const unsub = subscribe(SESSION, listener);
+    try {
+      ingestHarnessChunk(SESSION, { type: "token", content: "前半段" });
+      vi.advanceTimersByTime(5);
+      ingestHarnessChunk(SESSION, { type: "token", content: "尾字" });
+      expect(listener).toHaveBeenCalledTimes(1);
+
+      ingestHarnessChunk(SESSION, {
+        type: "error",
+        message: "upstream timeout",
+      });
+      expect(listener).toHaveBeenCalledTimes(2);
+      const msgs = getSnapshot(SESSION).messages;
+      expect(msgs[0]?.content).toBe("前半段尾字");
+      expect(msgs[1]?.status).toBe("error");
+      expect(msgs[1]?.content).toBe("upstream timeout");
+    } finally {
+      unsub();
+    }
+  });
+
+  it("flushes immediately on cancelStream without losing buffered text", () => {
+    const listener = vi.fn();
+    const unsub = subscribe(SESSION, listener);
+    try {
+      ingestHarnessChunk(SESSION, { type: "token", content: "生成中" });
+      vi.advanceTimersByTime(5);
+      ingestHarnessChunk(SESSION, { type: "token", content: "最后一句" });
+      expect(listener).toHaveBeenCalledTimes(1);
+
+      cancelStream(SESSION);
+      expect(listener).toHaveBeenCalledTimes(2);
+      const afterCancel = getSnapshot(SESSION).messages;
+      expect(afterCancel[0]?.content).toBe("生成中最后一句");
+      expect(afterCancel[0]?.status).toBe("done");
+
+      vi.advanceTimersByTime(100);
+      expect(listener).toHaveBeenCalledTimes(2);
+    } finally {
+      unsub();
+    }
+  });
+
+  it("cancels pending paint timers on removeSession", () => {
+    const listener = vi.fn();
+    const unsub = subscribe(SESSION, listener);
+    try {
+      ingestHarnessChunk(SESSION, { type: "token", content: "start" });
+      vi.advanceTimersByTime(5);
+      ingestHarnessChunk(SESSION, { type: "token", content: "pending" });
+      expect(listener).toHaveBeenCalledTimes(1);
+
+      removeSession(SESSION);
+      vi.advanceTimersByTime(100);
+      expect(listener).toHaveBeenCalledTimes(1);
+    } finally {
+      unsub();
+    }
+  });
+});
+
+describe("chatStore protects streaming replies from history overwrite", () => {
+  afterEach(() => {
+    removeSession(SESSION);
+    vi.unstubAllGlobals();
+  });
+
+  it("blocks setHistoryPage while a streaming assistant message is active", () => {
+    appendUserMessage(SESSION, makeMessage("u1", "请帮我写代码"));
+    ingestHarnessChunk(SESSION, { type: "token", content: "正在生成回复..." });
+    ingestHarnessChunk(SESSION, {
+      type: "usage",
+      usage: { input_tokens: 100, output_tokens: 20 },
+    });
+
+    // Unpersisted server history (only has the user message, no streaming reply)
+    setHistoryPage(SESSION, [makeMessage("u1", "请帮我写代码")], {
+      hasMore: false,
+      nextOffset: 1,
+    });
+
+    const snap = getSnapshot(SESSION);
+    expect(snap.messages).toHaveLength(2);
+    expect(snap.messages[1]?.content).toBe("正在生成回复...");
+    expect(snap.messages[1]?.status).toBe("streaming");
+    expect(snap.runUsage?.output_tokens).toBe(20);
+
+    // After stream finishes, normal history refresh succeeds.
+    ingestHarnessChunk(SESSION, { type: "done" });
+    setHistoryPage(
+      SESSION,
+      [
+        makeMessage("u1", "请帮我写代码"),
+        {
+          id: "a1-persisted",
+          role: "assistant",
+          content: "完整落库回复",
+          status: "done",
+          timestamp: Date.now(),
+        },
+      ],
+      { hasMore: false, nextOffset: 2 },
+    );
+
+    const afterDone = getSnapshot(SESSION);
+    expect(afterDone.messages).toHaveLength(2);
+    expect(afterDone.messages[1]?.content).toBe("完整落库回复");
+    expect(afterDone.historyHydrated).toBe(true);
+  });
+
+  it("blocks setHistoryPage while sendTurn is in flight before first token arrives", async () => {
+    class HangingSocket {
+      static readonly CONNECTING = 0;
+      static readonly OPEN = 1;
+      static readonly CLOSING = 2;
+      static readonly CLOSED = 3;
+      readyState = HangingSocket.CONNECTING;
+      onopen: (() => void) | null = null;
+      onmessage: ((event: { data: string }) => void) | null = null;
+      onerror: (() => void) | null = null;
+      onclose: (() => void) | null = null;
+      constructor(_url: string) {
+        queueMicrotask(() => {
+          this.readyState = HangingSocket.OPEN;
+          this.onopen?.();
+        });
+      }
+      send(_data: string) {}
+      close() {
+        this.readyState = HangingSocket.CLOSED;
+        this.onclose?.();
+      }
+    }
+    vi.stubGlobal("WebSocket", HangingSocket);
+
+    appendUserMessage(SESSION, makeMessage("u-live", "长任务"));
+    const turn = sendTurn(SESSION, "长任务", "agent-1", "", undefined, undefined, null, SESSION);
+    expect(getSnapshot(SESSION).isStreaming).toBe(true);
+
+    // Pull-to-refresh returns stale history missing the new user turn.
+    setHistoryPage(SESSION, [makeMessage("u-old", "旧消息")], {
+      hasMore: false,
+      nextOffset: 1,
+    });
+
+    expect(getSnapshot(SESSION).messages.map((m) => m.id)).toEqual(["u-live"]);
+
+    cancelStream(SESSION);
+    await turn;
+
+    // Once cancelled / idle, normal history loading works again.
+    setHistoryPage(SESSION, [makeMessage("u-old", "旧消息")], {
+      hasMore: true,
+      nextOffset: 25,
+    });
+    expect(getSnapshot(SESSION).messages.map((m) => m.id)).toEqual(["u-old"]);
+    expect(getSnapshot(SESSION).historyHasMore).toBe(true);
+  });
+});
