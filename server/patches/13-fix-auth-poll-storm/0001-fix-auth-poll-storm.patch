+import {
+  getAuthToken,
+  request,
+  SetupRequiredError,
+  UNAUTHORIZED_EVENT,
+} from "../../../api/request";
+
+export const MEMORY_POLL_BASE_DELAY_MS = 2000;
+export const MEMORY_POLL_MAX_DELAY_MS = 30000;
+
+/** Bounded exponential backoff for transient poll errors: 2s→4s→8s→16s→30s. */
+export function nextPollBackoffMs(consecutiveErrors: number): number {
+  if (consecutiveErrors <= 1) return MEMORY_POLL_BASE_DELAY_MS;
+  return Math.min(
+    MEMORY_POLL_BASE_DELAY_MS * 2 ** (consecutiveErrors - 1),
+    MEMORY_POLL_MAX_DELAY_MS,
+  );
+}
+
+function hasValidAuthToken(): boolean {
+  try {
+    return Boolean(getAuthToken().trim());
+  } catch {
+    return false;
+  }
+}
+
+function isAuthFailureError(err: unknown): boolean {
+  if (typeof SetupRequiredError === "function" && err instanceof SetupRequiredError) {
+    return true;
+  }
+  if (err && typeof err === "object") {
+    const status = (err as { status?: unknown }).status;
+    if (status === 401) return true;
+  }
+  if (err instanceof Error) {
+    return /\b(?:401|unauthorized|token_expired|auth_failed)\b/i.test(
+      err.message,
+    );
+  }
+  return false;
+}
 
