index 0000000000000000000000000000000000000000..89f40b8b9a98a7cf79e2c38c050aace9209e87db
--- /dev/null
+++ b/tests/unit/agents/test_user_sandbox_policy.py
@@ -0,0 +1,234 @@
+"""Unit tests for the ZBS enforced per-user sandbox policy (settings switch).
+
+Covers:
+- ``AgentManager.create`` backend override for non-admin owners (F4)
+- ``assert_user_may_change_backend`` guard for agent PATCH (F5)
+- ``enforced_sandbox_backend_name`` settings-key reading (switch on/off)
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+
+from octop.api.common.validators import assert_user_may_change_backend
+from octop.config import OctopConfig
+from octop.infra.agents.manager import AgentCreateSpec, AgentManager
+from octop.infra.db.migrate import run_migrations
+from octop.infra.db.pool import SqlitePool
+from octop.infra.db.services import build_shared_services
+from octop.infra.errors import ErrorCode, OctopError
+from octop.infra.users.identity import Role, User
+from octop.infra.users.resource_policy import (
+    ENFORCED_SANDBOX_BACKEND_SETTINGS_KEY,
+    enforced_sandbox_backend_name,
+)
+from octop.infra.utils.paths import PathLayout
+
+
+@pytest.fixture
+def manager(tmp_path: Path) -> AgentManager:
+    paths = PathLayout(tmp_path / ".octop")
+    paths.ensure_root()
+    db = SqlitePool(paths.db)
+    run_migrations(db)
+    services = build_shared_services(db=db, paths=paths, config=OctopConfig())
+    return AgentManager(repos=services.repos, paths=services.paths)
+
+
+def _seed_user(manager: AgentManager, *, role: str, name: str = "alice") -> int:
+    return manager._repos.user_repo.create(username=name, role=role, password_hash=None)
+
+
+def _switch_on(manager: AgentManager, name: str = "user-sandbox") -> None:
+    manager._repos.storage_backend_repo.create(
+        name=name,
+        kind="docker",
+        endpoint=None,
+        access_key=None,
+        secret_key=None,
+        bucket="python:3.12-slim",
+        region=None,
+        config_json=json.dumps({"sandbox_scope": "user", "sandbox_prefix": "octop_sandbox"}),
+        note=None,
+    )
+    manager._repos.settings_repo.set(ENFORCED_SANDBOX_BACKEND_SETTINGS_KEY, name)
+
+
+# ---------------------------------------------------------------------------
+# switch reading
+# ---------------------------------------------------------------------------
+
+
+def test_switch_off_by_default(manager: AgentManager) -> None:
+    assert enforced_sandbox_backend_name(manager._repos.settings_repo) is None
+
+
+def test_switch_reads_settings_key(manager: AgentManager) -> None:
+    manager._repos.settings_repo.set(ENFORCED_SANDBOX_BACKEND_SETTINGS_KEY, "sbx")
+    assert enforced_sandbox_backend_name(manager._repos.settings_repo) == "sbx"
+    manager._repos.settings_repo.set(ENFORCED_SANDBOX_BACKEND_SETTINGS_KEY, "  ")
+    assert enforced_sandbox_backend_name(manager._repos.settings_repo) is None
+
+
+# ---------------------------------------------------------------------------
+# F4 — create() backend override
+# ---------------------------------------------------------------------------
+
+
+async def test_create_overrides_backend_for_non_admin(manager: AgentManager) -> None:
+    uid = _seed_user(manager, role="user")
+    _switch_on(manager)
+    row = await manager.create(
+        AgentCreateSpec(
+            name="sbx-agent",
+            user_id=uid,
+            config={
+                "memory": {"memory_enabled": False},
+                "backend": {"type": "local_shell", "root_dir": "/", "virtual_mode": True},
+            },
+        ),
+        defer_bootstrap=True,
+    )
+    cfg = json.loads(manager._repos.agent_repo.get(row.agent_id).config_json or "{}")
+    assert cfg["backend"] == {"type": "named", "name": "user-sandbox"}
+
+
+async def test_create_official_backend_when_switch_off(manager: AgentManager) -> None:
+    uid = _seed_user(manager, role="user")
+    requested = {"type": "local_shell", "root_dir": "/", "virtual_mode": True}
+    row = await manager.create(
+        AgentCreateSpec(
+            name="plain-agent",
+            user_id=uid,
+            config={"memory": {"memory_enabled": False}, "backend": requested},
+        ),
+        defer_bootstrap=True,
+    )
+    cfg = json.loads(manager._repos.agent_repo.get(row.agent_id).config_json or "{}")
+    assert cfg["backend"] == requested
+
+
+async def test_create_admin_owner_not_overridden(manager: AgentManager) -> None:
+    uid = _seed_user(manager, role="admin")
+    _switch_on(manager)
+    requested = {"type": "local_shell", "root_dir": "/", "virtual_mode": True}
+    row = await manager.create(
+        AgentCreateSpec(
+            name="admin-agent",
+            user_id=uid,
+            config={"memory": {"memory_enabled": False}, "backend": requested},
+        ),
+        defer_bootstrap=True,
+    )
+    cfg = json.loads(manager._repos.agent_repo.get(row.agent_id).config_json or "{}")
+    assert cfg["backend"] == requested
+
+
+async def test_create_team_agent_also_overridden(manager: AgentManager) -> None:
+    uid = _seed_user(manager, role="user")
+    _switch_on(manager)
+    row = await manager.create(
+        AgentCreateSpec(
+            name="team",
+            user_id=uid,
+            kind="team",
+            config={},
+        ),
+        defer_bootstrap=True,
+    )
+    cfg = json.loads(manager._repos.agent_repo.get(row.agent_id).config_json or "{}")
+    assert cfg["backend"] == {"type": "named", "name": "user-sandbox"}
+
+
+# ---------------------------------------------------------------------------
+# F5 — PATCH backend change guard
+# ---------------------------------------------------------------------------
+
+
+def _user(is_admin: bool) -> User:
+    return User(
+        id=1,
+        username="u",
+        role=Role.ADMIN if is_admin else Role.USER,
+        display_name=None,
+    )
+
+
+def _settings_repo(switch: str | None) -> object:
+    class _Repo:
+        def __init__(self, value: str | None) -> None:
+            self.value = value
+
+        def get(self, key: str) -> str | None:
+            return self.value if key == ENFORCED_SANDBOX_BACKEND_SETTINGS_KEY else None
+
+    return _Repo(switch)
+
+
+_STORED = json.dumps({"backend": {"type": "named", "name": "user-sandbox"}, "persona": "INTJ"})
+
+
+def test_patch_blocks_backend_change_when_switch_on() -> None:
+    with pytest.raises(OctopError) as ei:
+        assert_user_may_change_backend(
+            _user(False),
+            current_config_json=_STORED,
+            new_config={"backend": {"type": "local_shell", "root_dir": "/"}},
+            settings_repo=_settings_repo("user-sandbox"),
+        )
+    assert ei.value.code is ErrorCode.FORBIDDEN
+
+
+def test_patch_blocks_missing_backend_key_when_switch_on() -> None:
+    # PATCH replaces the whole config blob — dropping the key would revert
+    # the agent to the official default backend, so it must be rejected too.
+    with pytest.raises(OctopError) as ei:
+        assert_user_may_change_backend(
+            _user(False),
+            current_config_json=_STORED,
+            new_config={"persona": "INTJ"},
+            settings_repo=_settings_repo("user-sandbox"),
+        )
+    assert ei.value.code is ErrorCode.FORBIDDEN
+
+
+def test_patch_allows_same_backend_when_switch_on() -> None:
+    assert_user_may_change_backend(
+        _user(False),
+        current_config_json=_STORED,
+        new_config={
+            "backend": {"type": "named", "name": "user-sandbox"},
+            "persona": "ENFP",
+        },
+        settings_repo=_settings_repo("user-sandbox"),
+    )
+
+
+def test_patch_allows_anything_when_switch_off() -> None:
+    assert_user_may_change_backend(
+        _user(False),
+        current_config_json=_STORED,
+        new_config={"persona": "ENFP"},
+        settings_repo=_settings_repo(None),
+    )
+
+
+def test_patch_admin_bypasses_guard() -> None:
+    assert_user_may_change_backend(
+        _user(True),
+        current_config_json=_STORED,
+        new_config={"backend": {"type": "local_shell", "root_dir": "/"}},
+        settings_repo=_settings_repo("user-sandbox"),
+    )
+
+
+def test_patch_non_dict_config_ignored() -> None:
+    assert_user_may_change_backend(
+        _user(False),
+        current_config_json=_STORED,
+        new_config=None,
+        settings_repo=_settings_repo("user-sandbox"),
+    )
