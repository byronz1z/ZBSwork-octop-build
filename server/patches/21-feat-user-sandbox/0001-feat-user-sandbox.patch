+def test_username_safe_for_placeholder_rules() -> None:
+    """ZBS round 4: which usernames may be substituted into a path."""
+    from octop.infra.backend.docker_spec import username_safe_for_placeholder
+
+    # Safe: ordinary, non-ASCII (official allows them), embedded dots.
+    assert username_safe_for_placeholder("alice") is True
+    assert username_safe_for_placeholder("张三") is True
+    assert username_safe_for_placeholder("john.doe") is True
+    assert username_safe_for_placeholder("a_b-c") is True
+    # Unsafe: empty / blank, directory aliases, separators, control chars.
+    assert username_safe_for_placeholder(None) is False
+    assert username_safe_for_placeholder("") is False
+    assert username_safe_for_placeholder("   ") is False
+    assert username_safe_for_placeholder(".") is False
+    assert username_safe_for_placeholder("..") is False
+    assert username_safe_for_placeholder("a/b") is False
+    assert username_safe_for_placeholder("a\\b") is False
+    assert username_safe_for_placeholder("a\x00b") is False
+    assert username_safe_for_placeholder("a\nb") is False
+    assert username_safe_for_placeholder("a\x7fb") is False
