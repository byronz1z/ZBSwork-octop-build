+def username_safe_for_placeholder(username: str | None) -> bool:
+    """Whether *username* may be substituted into a path (ZBS).
+
+    Rejects empty, ``.`` / ``..`` (directory aliases), and any username
+    containing a path separator (``/`` or ``\\``) or a control character —
+    all of these could escape the per-user folder or corrupt the path.
+    Everything else — including non-ASCII usernames and embedded dots like
+    ``john.doe`` — is used verbatim. Official Octop only requires usernames
+    to be non-empty at creation (``UserManager.create``), so unsafe legacy
+    usernames may exist in existing installs.
+    """
+    if not username:
+        return False
+    if username.strip() == "":
+        return False
+    if username in (".", ".."):
+        return False
+    if "/" in username or "\\" in username:
+        return False
+    return not any(ord(ch) < 32 or ord(ch) == 127 for ch in username)
+
+
+def resolve_username_placeholder(value: Any, username: str | None) -> Any:
+    """Expand ``{username}`` in *value* to the agent owner's username (ZBS).
+
+    Used for per-user local backends whose ``root_dir`` / ``env`` values carry
+    the placeholder (e.g. ``/data/.octop/users/{username}``). The username is
+    injected by :func:`enrich_docker_backend_spec`'s octop caller and shared
+    here. Without a username the value is left as-is so the misconfiguration
+    surfaces explicitly; an *unsafe* username (see
+    :func:`username_safe_for_placeholder`) is likewise never substituted —
+    callers decide how to report it.
+    """
+    if not isinstance(value, str) or not username:
+        return value
+    if not username_safe_for_placeholder(username):
+        return value
+    return value.replace("{username}", username)
+
+
