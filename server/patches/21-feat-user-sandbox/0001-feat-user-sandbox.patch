+# ZBS: settings key holding the site-wide enforced per-user sandbox backend
+# (a ``storage_backends.name`` of a kind=docker / sandbox_scope=user row).
+# Empty/absent = switch off = official Octop behavior everywhere.
+ENFORCED_SANDBOX_BACKEND_SETTINGS_KEY = "agent_enforced_backend"
+
+
+def enforced_sandbox_backend_name(settings_repo: Any) -> str | None:
+    """Name of the enforced per-user sandbox backend, or ``None`` when off."""
+    raw = settings_repo.get(ENFORCED_SANDBOX_BACKEND_SETTINGS_KEY)
+    if raw is None:
+        return None
+    name = str(raw).strip()
+    return name or None
+
+
+def user_row_is_admin(user_row: Any) -> bool:
+    """True when a ``users`` row (``UserRow``) carries the admin role."""
+    return getattr(user_row, "role", None) == ADMIN_USER_ROLE_ID
