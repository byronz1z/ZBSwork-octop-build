+@router.put(
+    "/settings/agent-sandbox",
+    summary="Set the enforced per-user sandbox backend (ZBS)",
+    response_model=AgentSandboxSettingsResponse,
+)
+async def put_agent_sandbox_settings(
+    body: AgentSandboxSettingsPut,
+    admin: User = Depends(require_permission("storage_backends")),
+    server: Any = Depends(get_server),
+) -> AgentSandboxSettingsResponse:
+    """Point the enforced-sandbox switch at a configured docker storage backend.
+
+    Non-admin users' new agents are then created on that backend, and those
+    users may no longer change their agents' backend. Pass ``null`` (or an
+    empty name) to turn the switch off.
+    """
+    from octop.infra.users.resource_policy import (
+        ENFORCED_SANDBOX_BACKEND_SETTINGS_KEY,
+        enforced_sandbox_backend_name,
+    )
+
+    repo = server.services.storage_backend_repo
+    name = (body.name or "").strip() or None
+    if name is not None:
+        row = repo.get_by_name(name)
+        if row is None:
+            raise OctopError(
+                ErrorCode.STORAGE_BACKEND_REFERENCED,
+                f"storage backend {name!r} not found",
+            )
+        if str(row.kind or "").lower() != "docker" or not row.enabled:
+            raise OctopError(
+                ErrorCode.STORAGE_BACKEND_REFERENCED,
+                f"storage backend {name!r} must be an enabled docker backend",
+            )
+    if name is None:
+        server.services.settings_repo.delete(ENFORCED_SANDBOX_BACKEND_SETTINGS_KEY)
+    else:
+        server.services.settings_repo.set(ENFORCED_SANDBOX_BACKEND_SETTINGS_KEY, name)
+    server.services.audit_repo.write(
+        actor=admin.username,
+        action="settings.agent_sandbox.update",
+        target=name or "",
+    )
+    return AgentSandboxSettingsResponse(
+        name=enforced_sandbox_backend_name(server.services.settings_repo),
+    )
