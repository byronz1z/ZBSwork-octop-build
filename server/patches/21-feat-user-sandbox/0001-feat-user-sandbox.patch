+def _resolve_volumes_username_placeholder(
+    volumes: Any,
+    username: str | None,
+) -> Any:
+    """Expand ``{username}`` in *volumes* mount keys to the owner's username.
+
+    Only mapping-style specs (docker-py ``{host: {"bind": ..., "mode": ...}}``)
+    carry user-configurable volume names; list specs keep short-form mount
+    strings unchanged. Without a resolvable *username* the placeholder is
+    left as-is so an explicit Docker error surfaces the misconfiguration
+    instead of silently mounting a shared volume.
+    """
+    if not isinstance(volumes, dict) or not username:
+        return None
+    resolved: dict[str, Any] = {}
+    changed = False
+    for host, bind in volumes.items():
+        key = str(host)
+        if "{username}" in key:
+            resolved[key.replace("{username}", str(username))] = bind
+            changed = True
+        else:
+            resolved[key] = bind
+    return resolved if changed else None
+
