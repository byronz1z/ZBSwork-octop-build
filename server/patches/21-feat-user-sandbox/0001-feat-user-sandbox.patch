+"""Unit tests for the ZBS enforced per-user sandbox policy (settings switch).
+
+Covers:
+- ``AgentManager.create`` backend override for non-admin owners (F4)
+- ``assert_user_may_change_backend`` guard for agent PATCH (F5)
+- ``enforced_sandbox_backend_name`` settings-key reading (switch on/off)
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+
+from octop.api.common.validators import assert_user_may_change_backend
