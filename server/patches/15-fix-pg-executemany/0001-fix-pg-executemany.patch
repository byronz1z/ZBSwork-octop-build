index 0000000000000000000000000000000000000000..5530377cfab3e7e168044f0fc00e46bc95e9f23e
--- /dev/null
+++ b/tests/unit/infra/db/test_pg_executemany.py
@@ -0,0 +1,117 @@
+from __future__ import annotations
+
+from typing import Any
+
+import pytest
+
+from octop.infra.db.pool import _PgConnectionProxy
+
+
+class _FakeCursor:
+    def __init__(self, calls: list[tuple[str, list[Any]]], *, fail: Exception | None = None) -> None:
+        self._calls = calls
+        self._fail = fail
+        self.entered = False
+        self.exited = False
+
+    def __enter__(self) -> _FakeCursor:
+        self.entered = True
+        return self
+
+    def __exit__(self, exc_type: Any, exc: Any, tb: Any) -> bool:
+        self.exited = True
+        return False
+
+    def executemany(self, sql: str, params_seq: Any) -> None:
+        if self._fail is not None:
+            raise self._fail
+        self._calls.append((sql, list(params_seq)))
+
+
+class _FakePsycopgConnection:
+    """Mimics psycopg v3 Connection which exposes cursor().executemany() but NOT conn.executemany()."""
+
+    def __init__(self, *, fail: Exception | None = None) -> None:
+        self.calls: list[tuple[str, list[Any]]] = []
+        self.cursors: list[_FakeCursor] = []
+        self._fail = fail
+
+    def cursor(self) -> _FakeCursor:
+        cur = _FakeCursor(self.calls, fail=self._fail)
+        self.cursors.append(cur)
+        return cur
+
+
+def test_pg_connection_proxy_executemany_converts_qmark_and_closes_cursor() -> None:
+    raw = _FakePsycopgConnection()
+    assert not hasattr(raw, "executemany")
+    proxy = _PgConnectionProxy(raw)
+
+    rows = [
+        ("t1", "Chat 1", "2026-01-01T00:00:00Z"),
+        ("t2", "Chat 2", "2026-01-02T00:00:00Z"),
+    ]
+    proxy.executemany(
+        'INSERT INTO "threads"("id", "title", "created_at") VALUES (?, ?, ?)',
+        rows,
+    )
+
+    assert len(raw.cursors) == 1
+    assert raw.cursors[0].entered is True
+    assert raw.cursors[0].exited is True
+    assert raw.calls == [
+        (
+            'INSERT INTO "threads"("id", "title", "created_at") VALUES (%s, %s, %s)',
+            rows,
+        )
+    ]
+
+
+def test_pg_connection_proxy_executemany_supports_generator_and_empty_seq() -> None:
+    raw = _FakePsycopgConnection()
+    proxy = _PgConnectionProxy(raw)
+
+    gen = ((f"id-{i}", i) for i in range(3))
+    proxy.executemany("INSERT INTO care_push(id, count) VALUES (?, ?)", gen)
+    proxy.executemany("INSERT INTO care_push(id, count) VALUES (?, ?)", [])
+
+    assert raw.calls == [
+        ("INSERT INTO care_push(id, count) VALUES (%s, %s)", [("id-0", 0), ("id-1", 1), ("id-2", 2)]),
+        ("INSERT INTO care_push(id, count) VALUES (%s, %s)", []),
+    ]
+    assert all(c.entered and c.exited for c in raw.cursors)
+
+
+def test_pg_connection_proxy_executemany_matches_care_push_upsert_sql() -> None:
+    raw = _FakePsycopgConnection()
+    proxy = _PgConnectionProxy(raw)
+
+    rows = [
+        ("r1", "u1", "c1", "2026-01-01T00:00:00Z"),
+        ("r2", "u1", "c2", "2026-01-01T00:00:00Z"),
+    ]
+    proxy.executemany(
+        "INSERT INTO care_push_records (id, user_id, candidate_id, created_at) "
+        "VALUES (?, ?, ?, ?) ON CONFLICT DO NOTHING",
+        rows,
+    )
+
+    assert raw.calls == [
+        (
+            "INSERT INTO care_push_records (id, user_id, candidate_id, created_at) "
+            "VALUES (%s, %s, %s, %s) ON CONFLICT DO NOTHING",
+            rows,
+        ),
+    ]
+
+
+def test_pg_connection_proxy_executemany_closes_cursor_on_error() -> None:
+    raw = _FakePsycopgConnection(fail=RuntimeError("boom"))
+    proxy = _PgConnectionProxy(raw)
+
+    with pytest.raises(RuntimeError, match="boom"):
+        proxy.executemany("INSERT INTO t(a) VALUES (?)", [(1,)])
+
+    assert len(raw.cursors) == 1
+    assert raw.cursors[0].entered is True
+    assert raw.cursors[0].exited is True
