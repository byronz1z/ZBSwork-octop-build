index 0000000000000000000000000000000000000000..df87012713a6c8c281c1a2e0c1a71c30bdacb76a
--- /dev/null
+++ b/dashboard/src/utils/zbsDesktopNotify.test.ts
@@ -0,0 +1,157 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+
+import type { DashboardPushEvent } from "./dashboardPushToast";
+import {
+  buildDesktopNotification,
+  ensureNotificationPermission,
+  focusApp,
+  shouldDesktopNotify,
+} from "./zbsDesktopNotify";
+
+const parsed: DashboardPushEvent = {
+  type: "dashboard_push",
+  agent_id: "agent-1",
+  thread_id: "thread-1",
+  text: "hello",
+};
+
+describe("shouldDesktopNotify", () => {
+  it("浏览器不支持 Notification 时不发", () => {
+    expect(
+      shouldDesktopNotify({
+        visibilityState: "hidden",
+        hasFocus: false,
+        permission: "granted",
+        supported: false,
+      }),
+    ).toBe(false);
+  });
+
+  it("未授权时不发", () => {
+    expect(
+      shouldDesktopNotify({
+        visibilityState: "hidden",
+        hasFocus: false,
+        permission: "default",
+        supported: true,
+      }),
+    ).toBe(false);
+  });
+
+  it("页面隐藏时发", () => {
+    expect(
+      shouldDesktopNotify({
+        visibilityState: "hidden",
+        hasFocus: true,
+        permission: "granted",
+        supported: true,
+      }),
+    ).toBe(true);
+  });
+
+  it("页面可见但失焦时发", () => {
+    expect(
+      shouldDesktopNotify({
+        visibilityState: "visible",
+        hasFocus: false,
+        permission: "granted",
+        supported: true,
+      }),
+    ).toBe(true);
+  });
+
+  it("页面在前台（可见且有焦点）时不发", () => {
+    expect(
+      shouldDesktopNotify({
+        visibilityState: "visible",
+        hasFocus: true,
+        permission: "granted",
+        supported: true,
+      }),
+    ).toBe(false);
+  });
+});
+
+describe("buildDesktopNotification", () => {
+  it("短文本不截断，tag 按对话 id", () => {
+    const spec = buildDesktopNotification(parsed, "标题");
+    expect(spec).toEqual({
+      title: "标题",
+      body: "hello",
+      tag: "zbs-push-thread-1",
+    });
+  });
+
+  it("超过 200 字截断加省略号", () => {
+    const long = { ...parsed, text: "a".repeat(250) };
+    const spec = buildDesktopNotification(long, "标题");
+    expect(spec.body).toBe(`${"a".repeat(200)}…`);
+  });
+});
+
+describe("ensureNotificationPermission", () => {
+  afterEach(() => {
+    vi.unstubAllGlobals();
+  });
+
+  it("没有 Notification 时直接返回", async () => {
+    vi.stubGlobal("Notification", undefined);
+    await expect(ensureNotificationPermission()).resolves.toBeUndefined();
+  });
+
+  it("已授权时不请求", async () => {
+    const requestPermission = vi.fn();
+    vi.stubGlobal("Notification", {
+      permission: "granted",
+      requestPermission,
+    });
+    await ensureNotificationPermission();
+    expect(requestPermission).not.toHaveBeenCalled();
+  });
+
+  it("default 时请求一次，重复调用不再请求", async () => {
+    const requestPermission = vi.fn().mockResolvedValue("granted");
+    vi.stubGlobal("Notification", {
+      permission: "default",
+      requestPermission,
+    });
+    await ensureNotificationPermission();
+    await ensureNotificationPermission();
+    expect(requestPermission).toHaveBeenCalledTimes(1);
+  });
+
+  it("requestPermission 抛错时不向外抛", async () => {
+    const requestPermission = vi.fn().mockRejectedValue(new Error("denied"));
+    vi.stubGlobal("Notification", {
+      permission: "default",
+      requestPermission,
+    });
+    await expect(ensureNotificationPermission()).resolves.toBeUndefined();
+  });
+});
+
+describe("focusApp", () => {
+  afterEach(() => {
+    delete window.zbsDesktop;
+    vi.restoreAllMocks();
+  });
+
+  it("桌面壳注入 focusWindow 时优先用它", () => {
+    const focusWindow = vi.fn();
+    window.zbsDesktop = { isDesktop: true, focusWindow };
+    const nativeFocus = vi
+      .spyOn(window, "focus")
+      .mockImplementation(() => undefined);
+    focusApp();
+    expect(focusWindow).toHaveBeenCalledTimes(1);
+    expect(nativeFocus).not.toHaveBeenCalled();
+  });
+
+  it("没有桌面壳注入时退回 window.focus()", () => {
+    const nativeFocus = vi
+      .spyOn(window, "focus")
+      .mockImplementation(() => undefined);
+    focusApp();
+    expect(nativeFocus).toHaveBeenCalledTimes(1);
+  });
+});
diff --git a/dashboard/src/utils/zbsDesktopNotify.ts b/dashboard/src/utils/zbsDesktopNotify.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8808a7190a3cd89ed6620046eae7095c5b712108
--- /dev/null
+++ b/dashboard/src/utils/zbsDesktopNotify.ts
@@ -0,0 +1,88 @@
+import { truncatePushText } from "./dashboardPushToast";
+import type { DashboardPushEvent } from "./dashboardPushToast";
+
+declare global {
+  interface Window {
+    zbsDesktop?: {
+      isDesktop?: boolean;
+      focusWindow?: () => void;
+    };
+  }
+}
+
+export type DesktopNotifyGate = {
+  visibilityState: string;
+  hasFocus: boolean;
+  permission: NotificationPermission;
+  supported: boolean;
+};
+
+/** 页面不在前台（隐藏或失焦）且浏览器已授权时才发系统通知。 */
+export function shouldDesktopNotify(gate: DesktopNotifyGate): boolean {
+  if (!gate.supported) return false;
+  if (gate.permission !== "granted") return false;
+  if (gate.visibilityState === "hidden") return true;
+  if (gate.hasFocus === false) return true;
+  return false;
+}
+
+export type DesktopNotificationSpec = {
+  title: string;
+  body: string;
+  tag: string;
+};
+
+/** 组装系统通知内容；同一对话用同一 tag，连续消息覆盖而不是堆一排。 */
+export function buildDesktopNotification(
+  parsed: DashboardPushEvent,
+  title: string,
+): DesktopNotificationSpec {
+  return {
+    title,
+    body: truncatePushText(parsed.text, 200),
+    tag: `zbs-push-${parsed.thread_id}`,
+  };
+}
+
+let permissionRequested = false;
+
+/** 登录后请求一次通知权限；不支持/已授权/已拒绝都不动。 */
+export async function ensureNotificationPermission(): Promise<void> {
+  if (typeof window === "undefined" || !window.Notification) return;
+  if (window.Notification.permission !== "default") return;
+  if (permissionRequested) return;
+  permissionRequested = true;
+  try {
+    await window.Notification.requestPermission();
+  } catch {
+    // ignore: 某些环境 requestPermission 会抛（如非安全上下文）
+  }
+}
+
+/** 把窗口叫到前面：桌面壳用壳注入的 focusWindow()，普通浏览器退回 window.focus()。 */
+export function focusApp(): void {
+  if (typeof window.zbsDesktop?.focusWindow === "function") {
+    window.zbsDesktop.focusWindow();
+    return;
+  }
+  window.focus();
+}
+
+/** 发系统通知；点击 → 窗口叫到前面 → 跳对话 → 关通知。 */
+export function showDesktopNotification(
+  parsed: DashboardPushEvent,
+  title: string,
+  onClick: () => void,
+): void {
+  try {
+    const spec = buildDesktopNotification(parsed, title);
+    const n = new Notification(spec.title, { body: spec.body, tag: spec.tag });
+    n.onclick = () => {
+      focusApp();
+      onClick();
+      n.close();
+    };
+  } catch {
+    // ignore: 有的浏览器在非安全上下文会抛
+  }
+}
