+describe("zbsMarkdownUrlTransform", () => {
+  it("preserves file://, local Windows/POSIX paths, relative paths, anchors, and safe protocols", () => {
+    expect(
+      zbsMarkdownUrlTransform(
+        "file:///data/.octop/users/alice/.octop/workspaces/A1/report.md",
+        "href",
+      ),
+    ).toBe("file:///data/.octop/users/alice/.octop/workspaces/A1/report.md");
+    expect(zbsMarkdownUrlTransform("file:///C:/Users/u/a.png", "src")).toBe(
+      "file:///C:/Users/u/a.png",
+    );
+    expect(zbsMarkdownUrlTransform("D:/work/docs/report.pdf", "href")).toBe(
+      "D:/work/docs/report.pdf",
+    );
+    expect(zbsMarkdownUrlTransform("D:\\work\\docs\\report.pdf", "href")).toBe(
+      "D:\\work\\docs\\report.pdf",
+    );
+    expect(zbsMarkdownUrlTransform("/localoctop/report.md", "href")).toBe(
+      "/localoctop/report.md",
+    );
+    expect(zbsMarkdownUrlTransform("docs/a.pdf", "href")).toBe("docs/a.pdf");
+    expect(zbsMarkdownUrlTransform("#section-1", "href")).toBe("#section-1");
+    expect(zbsMarkdownUrlTransform("https://example.com/a", "href")).toBe(
+      "https://example.com/a",
+    );
+    expect(zbsMarkdownUrlTransform("http://example.com", "href")).toBe(
+      "http://example.com",
+    );
+    expect(zbsMarkdownUrlTransform("mailto:test@example.com", "href")).toBe(
+      "mailto:test@example.com",
+    );
+    expect(zbsMarkdownUrlTransform("tel:+8613800138000", "href")).toBe(
+      "tel:+8613800138000",
+    );
+  });
+
+  it("allows data:image/* only for image src and blocks dangerous protocols", () => {
+    expect(
+      zbsMarkdownUrlTransform("data:image/png;base64,iVBORw0KGgo=", "src", {
+        tagName: "img",
+      }),
+    ).toBe("data:image/png;base64,iVBORw0KGgo=");
+    expect(
+      zbsMarkdownUrlTransform("data:image/png;base64,iVBORw0KGgo=", "href", {
+        tagName: "a",
+      }),
+    ).toBe("");
+    expect(
+      zbsMarkdownUrlTransform(
+        "data:text/html,<script>alert(1)</script>",
+        "src",
+        { tagName: "img" },
+      ),
+    ).toBe("");
+    expect(
+      zbsMarkdownUrlTransform(
+        "data:text/html,<script>alert(1)</script>",
+        "href",
+      ),
+    ).toBe("");
+    expect(zbsMarkdownUrlTransform("javascript:alert(1)", "href")).toBe("");
+    expect(zbsMarkdownUrlTransform("  JaVaScRiPt:alert(1)", "href")).toBe("");
+    expect(zbsMarkdownUrlTransform("java\tscript:alert(1)", "href")).toBe("");
+    expect(zbsMarkdownUrlTransform("java\nscript:alert(1)", "href")).toBe("");
+    expect(zbsMarkdownUrlTransform("vbscript:msgbox(1)", "href")).toBe("");
+    expect(zbsMarkdownUrlTransform("view-source:file:///etc/passwd", "href")).toBe(
+      "",
+    );
+  });
+});
