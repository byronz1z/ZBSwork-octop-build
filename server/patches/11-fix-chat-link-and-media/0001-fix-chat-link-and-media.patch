+      filename: "fig1.png",
+    });
+
+    // Legacy dead /api/workspace/media path is rewritten to the real endpoint.
+    expect(
+      resolveMarkdownImageTarget("/api/workspace/media?path=old/pic.png", "AG2"),
+    ).toEqual({
+      kind: "auth-blob",
+      url: "/api/agents/AG2/workspace/download?path=old%2Fpic.png",
+      filename: "pic.png",
+    });
+  });
+
+  it("handles existing auth media endpoints, external/data images, and invalid/missing-agent paths", () => {
+    expect(
+      resolveMarkdownImageTarget(
+        "/api/agents/AG1/media/preview?source=outbound%2Fshot.jpg",
+      ),
+    ).toEqual({
+      kind: "auth-blob",
+      url: "/api/agents/AG1/media/preview?source=outbound%2Fshot.jpg",
+      filename: "shot.jpg",
+    });
+
+    expect(
+      resolveMarkdownImageTarget("https://cdn.example.com/a.png"),
+    ).toEqual({
+      kind: "direct",
+      src: "https://cdn.example.com/a.png",
+    });
+
+    expect(
+      resolveMarkdownImageTarget("data:image/png;base64,AAAA"),
