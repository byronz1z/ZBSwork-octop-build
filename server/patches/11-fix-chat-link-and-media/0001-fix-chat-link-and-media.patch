+        "https://app.example",
+      ),
+    ).toBe(false);
+    expect(isCrossOriginHttpUrl("report.pdf", "https://app.example")).toBe(
+      false,
+    );
+
+    expect(isKnownSpaRoute("/chat/agent1")).toBe(true);
+    expect(isKnownSpaRoute("/experts")).toBe(true);
+    expect(isKnownSpaRoute("/localoctop/a.md")).toBe(false);
+    expect(isKnownSpaRoute("/workspace/a.md")).toBe(false);
+    expect(isKnownSpaRoute("/workspace")).toBe(true);
+
+    expect(isPreviewableChatFile("report.md")).toBe(true);
+    expect(isPreviewableChatFile("slides.pdf")).toBe(true);
+    expect(isPreviewableChatFile("photo.png")).toBe(true);
+    expect(isPreviewableChatFile("archive.zip")).toBe(false);
+
+    expect(
