index 0000000000000000000000000000000000000000..3a085c55b0829c1b7264925f5044a38b62bc392e
--- /dev/null
+++ b/dashboard/src/components/Markdown/ZbsChatLinkAndMedia.tsx
@@ -0,0 +1,295 @@
+/**
+ * Chat Markdown link router and authenticated local image renderer (ZBS patch 11).
+ *
+ * Keeps Markdown/index.tsx thin by encapsulating:
+ * - 4-way link routing (workspace preview/download, in-page anchor, SPA route, external)
+ * - Authenticated blob-fetch image rendering with deterministic URL.revokeObjectURL cleanup
+ */
+
+import {
+  createContext,
+  useCallback,
+  useContext,
+  useEffect,
+  useMemo,
+  useState,
+  type AnchorHTMLAttributes,
+  type ImgHTMLAttributes,
+  type MouseEvent,
+  type ReactNode,
+} from "react";
+import * as ReactRouterDom from "react-router-dom";
+import { useTranslation } from "react-i18next";
+import { message as antMessage } from "@/utils/antdMessage";
+import { getActiveAgentId, requestBlob } from "../../api/request";
+import { useChatFilePreview } from "../../pages/Chat/ChatFilePreviewContext";
+import { asImageBlob } from "../../utils/toolMediaBlocks";
+import {
+  apiPathForAuthBlob,
+  classifyChatLink,
+  resolveMarkdownImageTarget,
+} from "../../utils/zbsChatLinks";
+import { downloadAuthFile } from "../AuthFileDownloadLink";
+
+const FallbackNavContext = createContext<unknown>(null);
+
+function useSafeSpaNavigate(): (to: string) => void {
+  const navCtx = useContext(
+    (
+      ReactRouterDom as unknown as {
+        UNSAFE_NavigationContext?: React.Context<unknown>;
+      }
+    ).UNSAFE_NavigationContext ?? FallbackNavContext,
+  ) as { navigator?: { push?: (to: string) => void } } | null;
+
+  return useCallback(
+    (to: string) => {
+      if (navCtx?.navigator?.push) {
+        navCtx.navigator.push(to);
+        return;
+      }
+      window.location.assign(to);
+    },
+    [navCtx],
+  );
+}
+
+export function ZbsMarkdownLink({
+  href,
+  agentId,
+  children,
+  onClick,
+  node: _node,
+  ...props
+}: {
+  href?: string;
+  agentId?: string | null;
+  children?: ReactNode;
+  node?: unknown;
+} & AnchorHTMLAttributes<HTMLAnchorElement>) {
+  const { t } = useTranslation();
+  const filePreview = useChatFilePreview();
+  const navigateSpa = useSafeSpaNavigate();
+  const [downloading, setDownloading] = useState(false);
+
+  const effectiveAgentId = (agentId ?? "").trim() || getActiveAgentId();
+  const action = useMemo(
+    () => classifyChatLink(href, { agentId: effectiveAgentId }),
+    [href, effectiveAgentId],
+  );
+
+  const handleWorkspaceClick = useCallback(
+    async (event: MouseEvent<HTMLAnchorElement>) => {
+      onClick?.(event);
+      if (event.defaultPrevented) return;
+      event.preventDefault();
+      event.stopPropagation();
+      if (action.kind !== "workspace-file") return;
+
+      if (action.previewable && filePreview) {
+        filePreview.openFilePreview(action.filePath, action.agentId);
+        return;
+      }
+
+      if (!action.downloadUrl) {
+        antMessage.error(t("chat.downloadFailed", "下载失败，请重试"));
+        return;
+      }
+
+      setDownloading(true);
+      try {
+        await downloadAuthFile(action.downloadUrl, {
+          filename: action.filename,
+        });
+      } catch {
+        antMessage.error(t("chat.downloadFailed", "下载失败，请重试"));
+      } finally {
+        setDownloading(false);
+      }
+    },
+    [action, filePreview, onClick, t],
+  );
+
+  const handleSpaClick = useCallback(
+    (event: MouseEvent<HTMLAnchorElement>) => {
+      onClick?.(event);
+      if (
+        event.defaultPrevented ||
+        event.button !== 0 ||
+        event.metaKey ||
+        event.ctrlKey ||
+        event.shiftKey ||
+        event.altKey
+      ) {
+        return;
+      }
+      if (action.kind !== "spa-route") return;
+      event.preventDefault();
+      navigateSpa(action.to);
+    },
+    [action, navigateSpa, onClick],
+  );
+
+  if (action.kind === "blocked") {
+    return (
+      <span className={props.className} title={props.title}>
+        {children}
+      </span>
+    );
+  }
+
+  if (action.kind === "anchor") {
+    return (
+      <a href={action.href} onClick={onClick} {...props}>
+        {children}
+      </a>
+    );
+  }
+
+  if (action.kind === "spa-route") {
+    return (
+      <a href={action.to} onClick={handleSpaClick} {...props}>
+        {children}
+      </a>
+    );
+  }
+
+  if (action.kind === "same-origin-url") {
+    return (
+      <a href={action.href} onClick={onClick} {...props}>
+        {children}
+      </a>
+    );
+  }
+
+  if (action.kind === "workspace-file") {
+    return (
+      <a
+        href={action.downloadUrl || "#"}
+        onClick={(e) => void handleWorkspaceClick(e)}
+        aria-busy={downloading || undefined}
+        style={downloading ? { cursor: "wait", ...props.style } : props.style}
+        {...props}
+      >
+        {children}
+      </a>
+    );
+  }
+
+  return (
+    <a
+      href={action.href}
+      target="_blank"
+      rel="noreferrer"
+      onClick={onClick}
+      {...props}
+    >
+      {children}
+    </a>
+  );
+}
+
+/**
+ * Markdown image renderer:
+ * - Resolves workspace/local/file:// paths to the authenticated backend
+ *   `/api/agents/{id}/workspace/download` endpoint (never `/api/workspace/media`).
+ * - Fetches via `requestBlob` (with Bearer Authorization header) -> Blob URL.
+ * - Deterministic `URL.revokeObjectURL` on unmount or src change.
+ * - Graceful `[alt || "image"]` fallback on failure.
+ */
+export function ZbsMarkdownImage({
+  src,
+  alt,
+  agentId,
+  style,
+  onError,
+  node: _node,
+  ...props
+}: {
+  src?: string;
+  alt?: string;
+  agentId?: string | null;
+  node?: unknown;
+} & ImgHTMLAttributes<HTMLImageElement>) {
+  const effectiveAgentId = (agentId ?? "").trim() || getActiveAgentId();
+  const target = useMemo(
+    () => resolveMarkdownImageTarget(src, effectiveAgentId),
+    [src, effectiveAgentId],
+  );
+
+  const authUrl = target.kind === "auth-blob" ? target.url : null;
+  const authFilename = target.kind === "auth-blob" ? target.filename : undefined;
+  const directSrc = target.kind === "direct" ? target.src : null;
+
+  const [blobUrl, setBlobUrl] = useState<string | null>(null);
+  const [failed, setFailed] = useState(target.kind === "invalid");
+
+  useEffect(() => {
+    if (!authUrl) {
+      setBlobUrl(null);
+      setFailed(target.kind === "invalid");
+      return;
+    }
+
+    let cancelled = false;
+    let createdObjectUrl: string | null = null;
+    const controller = new AbortController();
+
+    setFailed(false);
+    setBlobUrl(null);
+
+    void requestBlob(apiPathForAuthBlob(authUrl), {
+      cache: "no-store",
+      signal: controller.signal,
+    })
+      .then((blob) => {
+        if (cancelled) return;
+        createdObjectUrl = URL.createObjectURL(asImageBlob(blob, authFilename));
+        setBlobUrl(createdObjectUrl);
+      })
+      .catch(() => {
+        if (!cancelled) {
+          setFailed(true);
+        }
+      });
+
+    return () => {
+      cancelled = true;
+      controller.abort();
+      if (createdObjectUrl) {
+        URL.revokeObjectURL(createdObjectUrl);
+      }
+    };
+  }, [authUrl, authFilename, target.kind]);
+
+  const handleImgError = useCallback(
+    (event: React.SyntheticEvent<HTMLImageElement, Event>) => {
+      setFailed(true);
+      onError?.(event);
+    },
+    [onError],
+  );
+
+  if (failed) {
+    return (
+      <span style={{ color: "var(--fn-text-tertiary, #999)", fontSize: 13 }}>
+        [{alt || "image"}]
+      </span>
+    );
+  }
+
+  const renderSrc = authUrl ? blobUrl : directSrc;
+  if (!renderSrc) {
+    return null;
+  }
+
+  return (
+    <img
+      src={renderSrc}
+      alt={alt}
+      onError={handleImgError}
+      style={{ maxWidth: "100%", borderRadius: 8, ...style }}
+      {...props}
+    />
+  );
+}
