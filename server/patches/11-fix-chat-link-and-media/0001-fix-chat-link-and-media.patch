@@ -0,0 +1,629 @@
+/**
+ * Chat Markdown link classification, safe URL transform, and local/workspace
+ * media resolution for Octop dashboard (ZBS patch 11).
+ *
+ * Pure logic lives here so official UI files only keep thin mount points.
+ */
+
+import { getDocKind } from "../pages/Agent/Workspace/utils/docKind";
+import { isProbablyText } from "../pages/Agent/Workspace/utils/fileKind";
+import { getMediaKind } from "../pages/Agent/Workspace/utils/mediaKind";
+import {
+  needsAuthBlobFetch,
+  workspaceDownloadUrl,
+} from "./toolMediaBlocks";
+
+const SAFE_EXTERNAL_PROTOCOL_RE = /^(https?|mailto|tel|ircs?|xmpp)$/i;
+const SAFE_DATA_IMAGE_RE = /^data:image\/[a-z0-9.+-]+[;,]/i;
+const WINDOWS_DRIVE_PATH_RE = /^[A-Za-z]:[\\/]/;
+const CONTROL_CHARS_RE = /[\u0000-\u001f\u007f]+/g;
+
+/** Known dashboard SPA routes (from App.tsx + routes/index.tsx). */
+const EXACT_SPA_ROUTES = new Set([
+  "/",
+  "/workspace",
+  "/setup",
+  "/invite",
+  "/pwa-debug",
+]);
+
+const PREFIX_SPA_ROUTES = [
+  "/chat",
+  "/experts",
+  "/tasks",
+  "/connectors",
+  "/skill-packages",
+  "/knowledge-bases",
+  "/bridge",
+  "/personalization",
+  "/skills",
+  "/token-usage",
+  "/agent-config",
+  "/acp",
+  "/channels",
+  "/workbench",
+  "/terminal",
+  "/remote-browser",
+  "/remote-desktop",
+  "/remote-phone",
+  "/remote-android",
+  "/subagents",
+  "/mbti",
+  "/memory",
+  "/admin",
+  "/models",
+  "/orca",
+  "/octop",
+  "/advanced-settings",
+  "/environments",
+  "/updates",
+  "/plugins",
+  "/sessions",
+  "/cron-jobs",
+  "/login",
+];
+
+const POSIX_HOST_FILE_ROOTS = [
+  "/tmp/",
+  "/home/",
+  "/users/",
+  "/data/",
+  "/var/",
+  "/root/",
+  "/opt/",
+  "/mnt/",
+  "/srv/",
+  "/private/",
+];
+
+const EXTENSIONLESS_FILENAMES = new Set([
+  "dockerfile",
+  "gemfile",
+  "makefile",
+  "procfile",
+  "readme",
+  "license",
+  ".editorconfig",
+  ".gitattributes",
+  ".gitignore",
+  ".npmrc",
+  ".prettierignore",
+  ".prettierrc",
+]);
+
+export interface WorkspaceFileTarget {
+  /** Workspace-relative path (no leading slash) or host-absolute path. */
+  filePath: string;
+  /** Agent id extracted from path, or fallback agent id if provided. */
+  agentId: string | null;
+  /** Display / download basename. */
+  filename: string;
+  /** True when filePath is a host-absolute path outside workspace markers. */
+  isHostAbsolute: boolean;
+}
+
+export type ChatLinkAction =
+  | { kind: "blocked" }
+  | { kind: "anchor"; href: string }
+  | {
+      kind: "workspace-file";
+      rawHref: string;
+      filePath: string;
+      agentId: string | null;
+      filename: string;
+      previewable: boolean;
+      downloadUrl: string | null;
+    }
+  | { kind: "spa-route"; to: string }
+  | { kind: "same-origin-url"; href: string }
+  | { kind: "external"; href: string };
+
+export type MarkdownImageTarget =
+  | { kind: "invalid" }
+  | { kind: "direct"; src: string }
+  | { kind: "auth-blob"; url: string; filename?: string };
+
+function stripControlChars(value: string): string {
+  return value.replace(CONTROL_CHARS_RE, "");
+}
+
+function safeDecodeUri(value: string): string {
+  try {
+    return decodeURIComponent(value);
+  } catch {
+    return value;
+  }
+}
+
+function stripQueryAndHash(raw: string): string {
+  const hashIdx = raw.indexOf("#");
+  const withoutHash = hashIdx >= 0 ? raw.slice(0, hashIdx) : raw;
+  const queryIdx = withoutHash.indexOf("?");
+  return queryIdx >= 0 ? withoutHash.slice(0, queryIdx) : withoutHash;
+}
+
+function extractScheme(value: string): string | null {
+  const cleaned = stripControlChars(value).trim();
+  if (!cleaned) return null;
+  if (WINDOWS_DRIVE_PATH_RE.test(cleaned)) return null;
+  const colon = cleaned.indexOf(":");
+  if (colon <= 0) return null;
+  const slash = cleaned.indexOf("/");
+  const backslash = cleaned.indexOf("\\");
+  const question = cleaned.indexOf("?");
+  const hash = cleaned.indexOf("#");
+  if (
+    (slash !== -1 && colon > slash) ||
+    (backslash !== -1 && colon > backslash) ||
+    (question !== -1 && colon > question) ||
+    (hash !== -1 && colon > hash)
+  ) {
+    return null;
+  }
+  return cleaned.slice(0, colon).replace(/\s+/g, "").toLowerCase();
+}
+
+/**
+ * Custom react-markdown urlTransform:
+ * - Preserves file://, Windows drive paths (D:/...), POSIX paths (/...),
+ *   relative paths, anchors (#...), workspace://, and http/https/mailto/tel.
+ * - Allows data:image/* ONLY for image `src` attributes.
+ * - Blocks dangerous schemes such as javascript:, vbscript:, data:text/html.
+ */
+export function zbsMarkdownUrlTransform(
+  url: string,
+  key?: string,
+  node?: { tagName?: string },
+): string {
+  const trimmed = (url ?? "").trim();
+  if (!trimmed) return "";
+
+  const sanitized = stripControlChars(trimmed).trim();
+  if (!sanitized) return "";
+
+  if (WINDOWS_DRIVE_PATH_RE.test(trimmed)) {
+    return trimmed;
+  }
+
+  const scheme = extractScheme(sanitized);
+  if (scheme === null) {
+    return trimmed;
+  }
+
+  if (
+    SAFE_EXTERNAL_PROTOCOL_RE.test(scheme) ||
+    scheme === "file" ||
+    scheme === "workspace"
+  ) {
+    return trimmed;
+  }
+
+  if (scheme === "data") {
+    const isImageSrc = key === "src" || node?.tagName === "img";
+    if (isImageSrc && SAFE_DATA_IMAGE_RE.test(sanitized)) {
+      return trimmed;
+    }
+    return "";
+  }
+
+  return "";
+}
+
+/** True when *url* uses an allowed external link protocol (http/https/mailto/tel). */
+export function isSafeExternalUrl(url: string | undefined | null): boolean {
+  if (!url) return false;
+  const scheme = extractScheme(url);
+  return scheme !== null && SAFE_EXTERNAL_PROTOCOL_RE.test(scheme);
+}
+
+/** True when *url* is an http(s) URL pointing to a different origin. */
+export function isCrossOriginHttpUrl(
+  url: string | undefined | null,
+  currentOrigin?: string | null,
+): boolean {
+  if (!url) return false;
+  const trimmed = url.trim();
+  if (!/^https?:\/\//i.test(trimmed)) return false;
+  if (!currentOrigin) return true;
+  try {
+    return new URL(trimmed).origin !== currentOrigin;
+  } catch {
+    return false;
+  }
+}
+
+/** True when *href* targets a known dashboard SPA route (must not open _blank). */
+export function isKnownSpaRoute(href: string): boolean {
+  const trimmed = href.trim();
+  if (!trimmed.startsWith("/") || trimmed.startsWith("//")) return false;
+  const pathname = stripQueryAndHash(trimmed);
+  const normalized =
+    pathname.length > 1 ? pathname.replace(/\/+$/, "") : pathname;
+  if (EXACT_SPA_ROUTES.has(normalized)) return true;
+  return PREFIX_SPA_ROUTES.some(
+    (prefix) => normalized === prefix || normalized.startsWith(`${prefix}/`),
+  );
+}
+
+/** Files that ChatFilePreviewContext / FileViewer can preview inline. */
+export function isPreviewableChatFile(filePath: string): boolean {
+  const clean = stripQueryAndHash(filePath).trim();
+  if (!clean) return false;
+  return (
+    isProbablyText(clean) ||
+    getMediaKind(clean) !== null ||
+    getDocKind(clean) !== null
+  );
+}
+
+function basenameOf(filePath: string): string {
+  const clean = stripQueryAndHash(filePath).replace(/\\/g, "/");
+  const parts = clean.split("/").filter(Boolean);
+  return parts[parts.length - 1] || clean || "download";
+}
+
+function hasFileLikeBasename(posixPath: string): boolean {
+  const base = basenameOf(posixPath).toLowerCase();
+  if (!base) return false;
+  if (EXTENSIONLESS_FILENAMES.has(base)) return true;
+  const dot = base.lastIndexOf(".");
+  if (dot <= 0 || dot === base.length - 1) return false;
+  const ext = base.slice(dot + 1);
+  return /^[a-z0-9]{1,10}$/i.test(ext);
+}
+
+function decodeFileUriToPosix(raw: string): string {
+  let body = stripQueryAndHash(raw).trim();
+  if (!/^file:/i.test(body)) return body.replace(/\\/g, "/");
+  body = body.replace(/^file:\/\//i, "");
+  // Strip optional "localhost" authority in file://localhost/...
+  if (/^localhost\//i.test(body)) {
+    body = body.slice("localhost".length);
+  }
+  const decoded = safeDecodeUri(body).replace(/\\/g, "/");
+  // Windows drive form: /C:/Users/... -> C:/Users/...
+  if (/^\/[A-Za-z]:\//.test(decoded)) {
+    return decoded.slice(1);
+  }
+  return decoded;
+}
+
+/**
+ * Match explicit workspace / local bridge markers inside a normalized POSIX path:
+ *   - .octop/workspaces/<agentId>/<rel>
+ *   - .octop/agents/<agentId>/<rel>
+ *   - .octop/workspace/<rel>
+ *   - /localoctop/<rel>
+ *   - /workspace/<rel>
+ */
+function matchExplicitWorkspaceMarker(
+  posixPath: string,
+  fallbackAgentId?: string | null,
+): WorkspaceFileTarget | null {
+  const fallback = (fallbackAgentId ?? "").trim() || null;
+
+  const pluralMatch = posixPath.match(
+    /(?:^|\/)\.octop\/workspaces\/([^/]+)\/(.+)$/i,
+  );
+  if (pluralMatch?.[1] && pluralMatch[2]) {
+    const rel = pluralMatch[2].replace(/^\/+/, "");
+    if (rel) {
+      return {
+        filePath: rel,
+        agentId: pluralMatch[1],
+        filename: basenameOf(rel),
+        isHostAbsolute: false,
+      };
+    }
+  }
+
+  const agentsMatch = posixPath.match(
+    /(?:^|\/)\.octop\/agents\/([^/]+)\/(.+)$/i,
+  );
+  if (agentsMatch?.[1] && agentsMatch[2]) {
+    const rel = agentsMatch[2].replace(/^\/+/, "");
+    if (rel) {
+      return {
+        filePath: rel,
+        agentId: agentsMatch[1],
+        filename: basenameOf(rel),
+        isHostAbsolute: false,
+      };
+    }
+  }
+
+  const singularMatch = posixPath.match(/(?:^|\/)\.octop\/workspace\/(.+)$/i);
+  if (singularMatch?.[1]) {
+    const rel = singularMatch[1].replace(/^\/+/, "");
+    if (rel) {
+      return {
+        filePath: rel,
+        agentId: fallback,
+        filename: basenameOf(rel),
+        isHostAbsolute: false,
+      };
+    }
+  }
+
+  const localOctopMatch = posixPath.match(/(?:^|\/)localoctop\/(.+)$/i);
+  if (localOctopMatch?.[1]) {
+    const rel = localOctopMatch[1].replace(/^\/+/, "");
+    if (rel) {
+      return {
+        filePath: `/localoctop/${rel}`,
+        agentId: fallback,
+        filename: basenameOf(rel),
+        isHostAbsolute: true,
+      };
+    }
+  }
+
+  const virtualRootMatch = posixPath.match(/^\/workspace\/(.+)$/i);
+  if (virtualRootMatch?.[1]) {
+    const rel = virtualRootMatch[1].replace(/^\/+/, "");
+    if (rel) {
+      return {
+        filePath: rel,
+        agentId: fallback,
+        filename: basenameOf(rel),
+        isHostAbsolute: false,
+      };
+    }
+  }
+
+  return null;
+}
+
+/**
+ * Extract a workspace or local file target from a Markdown href / image src /
+ * attachment URL. Returns null for external URLs, anchors, API URLs, or SPA routes.
+ */
+export function extractWorkspaceFileTarget(
+  raw: string | undefined | null,
+  fallbackAgentId?: string | null,
+): WorkspaceFileTarget | null {
+  const trimmed = (raw ?? "").trim();
+  if (!trimmed || trimmed.startsWith("#") || trimmed.startsWith("?")) {
+    return null;
+  }
+
+  const fallback = (fallbackAgentId ?? "").trim() || null;
+
+  if (/^workspace:\/\//i.test(trimmed)) {
+    const rel = safeDecodeUri(stripQueryAndHash(trimmed).slice("workspace://".length))
+      .replace(/\\/g, "/")
+      .replace(/^\/+/, "");
+    if (!rel) return null;
+    return {
+      filePath: rel,
+      agentId: fallback,
+      filename: basenameOf(rel),
+      isHostAbsolute: false,
+    };
+  }
+
+  if (/^file:\/\//i.test(trimmed)) {
+    const posix = decodeFileUriToPosix(trimmed);
+    if (!posix) return null;
+    const marked = matchExplicitWorkspaceMarker(posix, fallback);
+    if (marked) return marked;
+    return {
+      filePath: posix,
+      agentId: fallback,
+      filename: basenameOf(posix),
+      isHostAbsolute: true,
+    };
+  }
+
+  const scheme = extractScheme(trimmed);
+  if (scheme !== null) {
+    return null;
+  }
+
+  if (trimmed.startsWith("//")) {
+    return null;
+  }
+
+  const stripped = stripQueryAndHash(trimmed);
+  const posix = safeDecodeUri(stripped).replace(/\\/g, "/");
+  if (!posix) return null;
+
+  // Explicit workspace markers take priority over everything else.
+  const marked = matchExplicitWorkspaceMarker(posix, fallback);
+  if (marked) return marked;
+
+  // Windows drive-letter local path (e.g. D:/work/report.md)
+  if (WINDOWS_DRIVE_PATH_RE.test(posix)) {
+    return {
+      filePath: posix,
+      agentId: fallback,
+      filename: basenameOf(posix),
+      isHostAbsolute: true,
+    };
+  }
+
+  // Leading-slash paths: exclude /api/ and known SPA routes.
+  if (posix.startsWith("/")) {
+    if (posix.startsWith("/api/")) return null;
+    if (isKnownSpaRoute(posix)) return null;
+    if (posix.startsWith("/outbound/") || posix.startsWith("/inbound/")) {
+      const rel = posix.slice(1);
+      return {
+        filePath: rel,
+        agentId: fallback,
+        filename: basenameOf(rel),
+        isHostAbsolute: false,
+      };
+    }
+    const lower = posix.toLowerCase();
+    const isHostRoot = POSIX_HOST_FILE_ROOTS.some((root) =>
+      lower.startsWith(root),
+    );
+    if (isHostRoot || hasFileLikeBasename(posix)) {
+      return {
+        filePath: posix,
+        agentId: fallback,
+        filename: basenameOf(posix),
+        isHostAbsolute: true,
+      };
+    }
+    return null;
+  }
+
+  // Pure relative file path (e.g. report.md, docs/a.pdf, ./charts/fig.png)
+  const rel = posix.replace(/^(?:\.\/)+/, "");
+  if (!rel || rel === "." || rel === "..") return null;
+  return {
+    filePath: rel,
+    agentId: fallback,
+    filename: basenameOf(rel),
+    isHostAbsolute: false,
+  };
+}
+
+/**
+ * 4-way classifier for all non-AuthDownload Markdown links:
+ *   1. workspace-file: workspace/local bridge/relative file paths
+ *   2. anchor: in-page `#...` fragment links
+ *   3. spa-route: internal SPA routes (`/chat/...`, `/experts`, etc.)
+ *   4. external: `http/https/mailto/tel` links (safe for `target="_blank"`)
+ * Plus `same-origin-url` (non-auth `/api/...`) and `blocked` (empty/unsafe).
+ */
+export function classifyChatLink(
+  href: string | undefined | null,
+  options?: { agentId?: string | null },
+): ChatLinkAction {
+  const safeHref = zbsMarkdownUrlTransform(href ?? "", "href");
+  if (!safeHref) {
+    return { kind: "blocked" };
+  }
+
+  if (safeHref.startsWith("#")) {
+    return { kind: "anchor", href: safeHref };
+  }
+
+  if (isSafeExternalUrl(safeHref)) {
+    return { kind: "external", href: safeHref };
+  }
+
+  const workspaceTarget = extractWorkspaceFileTarget(
+    safeHref,
+    options?.agentId,
+  );
+  if (workspaceTarget) {
+    const downloadUrl = workspaceTarget.agentId
+      ? workspaceDownloadUrl(workspaceTarget.agentId, workspaceTarget.filePath)
+      : null;
+    return {
+      kind: "workspace-file",
+      rawHref: safeHref,
+      filePath: workspaceTarget.filePath,
+      agentId: workspaceTarget.agentId,
+      filename: workspaceTarget.filename,
+      previewable: isPreviewableChatFile(workspaceTarget.filePath),
+      downloadUrl,
+    };
+  }
+
+  if (safeHref.startsWith("/api/")) {
+    return { kind: "same-origin-url", href: safeHref };
+  }
+
+  if (safeHref.startsWith("/") && !safeHref.startsWith("//")) {
+    return { kind: "spa-route", to: safeHref };
+  }
+
+  return { kind: "blocked" };
+}
+
+/**
+ * Resolve a Markdown `<img src>` into either:
+ * - `direct`: external http(s), safe `data:image/*`, or unauthenticated `/api/`
+ * - `auth-blob`: authenticated backend `/api/agents/{id}/workspace/download`
+ *   (or existing auth media API URL) to be fetched with Authorization header
+ *   and converted to a revocable Blob URL
+ * - `invalid`: unsafe or unresolvable local path (renders graceful alt fallback)
+ */
+export function resolveMarkdownImageTarget(
+  src: string | undefined | null,
+  fallbackAgentId?: string | null,
+): MarkdownImageTarget {
+  const safeSrc = zbsMarkdownUrlTransform(src ?? "", "src", { tagName: "img" });
+  if (!safeSrc) {
+    return { kind: "invalid" };
+  }
+
+  if (SAFE_DATA_IMAGE_RE.test(stripControlChars(safeSrc).trim())) {
+    return { kind: "direct", src: safeSrc };
+  }
+
+  // Rewrite legacy dead /api/workspace/media?path=... URLs when agentId is known.
+  if (safeSrc.startsWith("/api/workspace/media")) {
+    try {
+      const parsed = new URL(safeSrc, "http://octop.local");
+      const rawPath = parsed.searchParams.get("path") || "";
+      const fallback = (fallbackAgentId ?? "").trim() || null;
+      if (rawPath && fallback) {
+        const rel = rawPath.replace(/\\/g, "/").replace(/^\/+/, "");
+        return {
+          kind: "auth-blob",
+          url: workspaceDownloadUrl(fallback, rel),
+          filename: basenameOf(rel),
+        };
+      }
+    } catch {
+      /* fall through to invalid */
+    }
+    return { kind: "invalid" };
+  }
+
+  if (needsAuthBlobFetch(safeSrc)) {
+    let fname: string | undefined;
+    try {
+      const parsed = /^https?:\/\//i.test(safeSrc)
+        ? new URL(safeSrc)
+        : new URL(safeSrc, "http://octop.local");
+      const rawParam =
+        parsed.searchParams.get("path") || parsed.searchParams.get("source");
+      fname = rawParam ? basenameOf(safeDecodeUri(rawParam)) : basenameOf(parsed.pathname);
+    } catch {
+      fname = basenameOf(safeSrc);
+    }
+    return {
+      kind: "auth-blob",
+      url: safeSrc,
+      filename: fname,
+    };
+  }
+
+  if (/^https?:\/\//i.test(safeSrc)) {
+    return { kind: "direct", src: safeSrc };
+  }
+
+  if (safeSrc.startsWith("/api/")) {
+    return { kind: "direct", src: safeSrc };
+  }
+
+  const workspaceTarget = extractWorkspaceFileTarget(safeSrc, fallbackAgentId);
+  if (workspaceTarget && workspaceTarget.agentId) {
+    return {
+      kind: "auth-blob",
+      url: workspaceDownloadUrl(
+        workspaceTarget.agentId,
+        workspaceTarget.filePath,
+      ),
+      filename: workspaceTarget.filename,
+    };
+  }
+
+  return { kind: "invalid" };
+}
+
+/** Strip `/api` prefix for `requestBlob(...)` which prepends the API base. */
+export function apiPathForAuthBlob(url: string): string {
+  if (/^https?:\/\//i.test(url)) {
+    const parsed = new URL(url);
+    return parsed.pathname.replace(/^\/api/, "") + parsed.search;
+  }
+  return url.replace(/^\/api/, "");
+}
