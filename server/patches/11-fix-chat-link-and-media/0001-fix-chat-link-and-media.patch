+import { fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { MemoryRouter, useLocation } from "react-router-dom";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import Markdown from "./index";
+import { ChatFilePreviewProvider } from "../../pages/Chat/ChatFilePreviewContext";
+import { MessageFileCard } from "../../pages/Chat/components/MessageFileCard";
+
+const mocks = vi.hoisted(() => ({
+  requestBlob: vi.fn(),
+  downloadAuthFile: vi.fn(),
+  getActiveAgentId: vi.fn<() => string | null>(() => null),
+  msgError: vi.fn(),
+}));
+
+vi.mock("react-i18next", () => ({
+  useTranslation: () => ({
+    t: (_key: string, fallback?: string) => fallback || _key,
+  }),
+}));
+
+vi.mock("../../api/request", () => ({
+  requestBlob: (...args: unknown[]) => mocks.requestBlob(...args),
+  getActiveAgentId: () => mocks.getActiveAgentId(),
+}));
+
+vi.mock("../AuthFileDownloadLink", async (importOriginal) => {
+  const actual =
+    await importOriginal<typeof import("../AuthFileDownloadLink")>();
+  return {
+    ...actual,
+    downloadAuthFile: (...args: unknown[]) => mocks.downloadAuthFile(...args),
+  };
+});
+
+vi.mock("@/utils/antdMessage", () => ({
+  message: {
+    error: (...args: unknown[]) => mocks.msgError(...args),
+    success: vi.fn(),
+  },
+}));
+
+function LocationDisplay() {
+  const location = useLocation();
+  return <div data-testid="loc">{location.pathname + location.search}</div>;
+}
+
+describe("Markdown link routing and local media (ZBS patch 11)", () => {
+  let createObjectURLMock: ReturnType<typeof vi.fn>;
+  let revokeObjectURLMock: ReturnType<typeof vi.fn>;
+  let originalCreateObjectURL: typeof URL.createObjectURL | undefined;
+  let originalRevokeObjectURL: typeof URL.revokeObjectURL | undefined;
+  let originalMatchMedia: typeof window.matchMedia;
+
+  beforeEach(() => {
+    mocks.requestBlob.mockReset();
+    mocks.downloadAuthFile.mockReset();
+    mocks.getActiveAgentId.mockReset();
+    mocks.getActiveAgentId.mockReturnValue(null);
+    mocks.msgError.mockReset();
+
+    originalMatchMedia = window.matchMedia;
+    window.matchMedia = vi.fn().mockImplementation(() => ({
+      matches: false,
+      addEventListener: vi.fn(),
+      removeEventListener: vi.fn(),
+    }));
+
+    originalCreateObjectURL = URL.createObjectURL;
+    originalRevokeObjectURL = URL.revokeObjectURL;
+    createObjectURLMock = vi.fn().mockReturnValue("blob:mock-local-img");
+    revokeObjectURLMock = vi.fn();
+    URL.createObjectURL =
+      createObjectURLMock as unknown as typeof URL.createObjectURL;
+    URL.revokeObjectURL =
+      revokeObjectURLMock as unknown as typeof URL.revokeObjectURL;
+  });
+
+  afterEach(() => {
+    URL.createObjectURL =
+      originalCreateObjectURL as typeof URL.createObjectURL;
+    URL.revokeObjectURL =
+      originalRevokeObjectURL as typeof URL.revokeObjectURL;
+    window.matchMedia = originalMatchMedia;
+  });
+
+  it("opens previewable workspace/local/relative files in ChatFilePreview without target=_blank", () => {
+    const openFilePreview = vi.fn();
+    render(
+      <MemoryRouter initialEntries={["/chat/AG1"]}>
+        <ChatFilePreviewProvider
+          openFilePreview={openFilePreview}
+          openKnowledgeCitation={vi.fn()}
+        >
+          <Markdown
+            agentId="AG1"
+            content={[
+              "[Workspace Report](file:///data/.octop/users/u/.octop/workspaces/AG2/docs/q1.md)",
+              "[Local Bridge](/localoctop/spec.pdf)",
+              "[Relative Note](notes/summary.md)",
+            ].join("\n\n")}
+          />
+        </ChatFilePreviewProvider>
+      </MemoryRouter>,
+    );
+
+    const wsLink = screen.getByText("Workspace Report").closest("a")!;
+    const localLink = screen.getByText("Local Bridge").closest("a")!;
+    const relLink = screen.getByText("Relative Note").closest("a")!;
+
+    expect(wsLink.getAttribute("target")).toBeNull();
+    expect(localLink.getAttribute("target")).toBeNull();
+    expect(relLink.getAttribute("target")).toBeNull();
+
+    fireEvent.click(wsLink);
+    expect(openFilePreview).toHaveBeenCalledWith("docs/q1.md", "AG2");
+
+    fireEvent.click(localLink);
+    expect(openFilePreview).toHaveBeenCalledWith("/localoctop/spec.pdf", "AG1");
+
+    fireEvent.click(relLink);
+    expect(openFilePreview).toHaveBeenCalledWith("notes/summary.md", "AG1");
+    expect(mocks.downloadAuthFile).not.toHaveBeenCalled();
+  });
+
+  it("falls back to downloadAuthFile for non-previewable files or when preview context is absent", async () => {
+    mocks.downloadAuthFile.mockResolvedValue(undefined);
+    const openFilePreview = vi.fn();
+
+    const { rerender } = render(
+      <MemoryRouter>
+        <ChatFilePreviewProvider
+          openFilePreview={openFilePreview}
+          openKnowledgeCitation={vi.fn()}
+        >
+          <Markdown
+            agentId="AG1"
+            content="[Archive](/localoctop/release.zip)"
+          />
+        </ChatFilePreviewProvider>
+      </MemoryRouter>,
+    );
+
+    fireEvent.click(screen.getByText("Archive"));
+    await waitFor(() => {
+      expect(mocks.downloadAuthFile).toHaveBeenCalledWith(
+        "/api/agents/AG1/workspace/download?path=%2Flocaloctop%2Frelease.zip",
+        { filename: "release.zip" },
+      );
+    });
+    expect(openFilePreview).not.toHaveBeenCalled();
+
+    // Without ChatFilePreviewProvider, even previewable files fall back to downloadAuthFile.
+    mocks.downloadAuthFile.mockClear();
+    rerender(
+      <MemoryRouter>
+        <Markdown agentId="AG1" content="[Doc](docs/readme.md)" />
+      </MemoryRouter>,
+    );
+    fireEvent.click(screen.getByText("Doc"));
+    await waitFor(() => {
+      expect(mocks.downloadAuthFile).toHaveBeenCalledWith(
+        "/api/agents/AG1/workspace/download?path=docs%2Freadme.md",
+        { filename: "readme.md" },
+      );
+    });
+  });
+
+  it("routes anchors, SPA routes, external links, and blocks XSS javascript: links", () => {
+    render(
+      <MemoryRouter initialEntries={["/chat/AG1"]}>
+        <LocationDisplay />
+        <Markdown
+          agentId="AG1"
+          content={[
+            "[Jump](#part-2)",
+            "[Go Experts](/experts)",
+            "[Go Thread](/chat/AG2/T9)",
+            "[Ext Web](https://example.com/a)",
+            "[Mail](mailto:hi@example.com)",
+            "[Phone](tel:+8613800138000)",
+            "[Evil](javascript:alert(1))",
+            "[EvilVB](vbscript:msgbox(1))",
+          ].join("\n\n")}
+        />
+      </MemoryRouter>,
+    );
+
+    const anchor = screen.getByText("Jump").closest("a")!;
+    expect(anchor.getAttribute("href")).toBe("#part-2");
+    expect(anchor.getAttribute("target")).toBeNull();
+
+    const experts = screen.getByText("Go Experts").closest("a")!;
+    expect(experts.getAttribute("target")).toBeNull();
+    fireEvent.click(experts);
+    expect(screen.getByTestId("loc")).toHaveTextContent("/experts");
+
+    const thread = screen.getByText("Go Thread").closest("a")!;
+    expect(thread.getAttribute("target")).toBeNull();
+    fireEvent.click(thread);
+    expect(screen.getByTestId("loc")).toHaveTextContent("/chat/AG2/T9");
+
+    for (const [label, expectedHref] of [
+      ["Ext Web", "https://example.com/a"],
+      ["Mail", "mailto:hi@example.com"],
+      ["Phone", "tel:+8613800138000"],
+    ] as const) {
+      const link = screen.getByText(label).closest("a")!;
+      expect(link.getAttribute("href")).toBe(expectedHref);
+      expect(link.getAttribute("target")).toBe("_blank");
+      expect(link.getAttribute("rel")).toBe("noreferrer");
+    }
+
+    // Dangerous links must NOT render as clickable anchors.
+    expect(screen.getByText("Evil").closest("a")).toBeNull();
+    expect(screen.getByText("EvilVB").closest("a")).toBeNull();
+  });
+
+  it("loads local workspace images via authenticated workspace/download blob and revokes object URL on unmount", async () => {
+    mocks.requestBlob.mockResolvedValue(
+      new Blob(["fake-png"], { type: "application/octet-stream" }),
+    );
+
+    const { unmount } = render(
+      <MemoryRouter>
+        <Markdown
+          agentId="AG1"
+          content="![Sales Chart](file:///data/.octop/users/u/.octop/workspaces/AG9/charts/sales.png)"
+        />
+      </MemoryRouter>,
+    );
+
+    await waitFor(() => {
+      expect(mocks.requestBlob).toHaveBeenCalledWith(
+        "/agents/AG9/workspace/download?path=charts%2Fsales.png",
+        expect.objectContaining({ cache: "no-store" }),
+      );
+    });
+
+    const img = await screen.findByAltText("Sales Chart");
+    expect(img).toHaveAttribute("src", "blob:mock-local-img");
+    expect(createObjectURLMock).toHaveBeenCalledTimes(1);
+
+    unmount();
+    expect(revokeObjectURLMock).toHaveBeenCalledWith("blob:mock-local-img");
+  });
+
+  it("revokes previous blob URL when local image src changes and supports relative/singular workspace paths", async () => {
+    mocks.requestBlob.mockResolvedValue(
+      new Blob(["fake-jpg"], { type: "application/octet-stream" }),
+    );
+    createObjectURLMock
+      .mockReturnValueOnce("blob:img-1")
+      .mockReturnValueOnce("blob:img-2");
+
+    const { rerender, unmount } = render(
+      <MemoryRouter>
+        <Markdown agentId="AG1" content="![First](./images/a.jpg)" />
+      </MemoryRouter>,
+    );
+
+    const first = await screen.findByAltText("First");
+    expect(first).toHaveAttribute("src", "blob:img-1");
+    expect(mocks.requestBlob).toHaveBeenCalledWith(
+      "/agents/AG1/workspace/download?path=images%2Fa.jpg",
+      expect.objectContaining({ cache: "no-store" }),
+    );
+
+    rerender(
+      <MemoryRouter>
+        <Markdown
+          agentId="AG1"
+          content="![Second](file:///home/u/.octop/workspace/b.png)"
+        />
+      </MemoryRouter>,
+    );
+
+    const second = await screen.findByAltText("Second");
+    expect(second).toHaveAttribute("src", "blob:img-2");
+    expect(revokeObjectURLMock).toHaveBeenCalledWith("blob:img-1");
+
+    unmount();
+    expect(revokeObjectURLMock).toHaveBeenCalledWith("blob:img-2");
+  });
+
+  it("degrades gracefully to alt placeholder when local image fetch fails", async () => {
+    mocks.requestBlob.mockRejectedValue(new Error("404"));
+
+    render(
+      <MemoryRouter>
+        <Markdown agentId="AG1" content="![Missing Pic](/localoctop/missing.png)" />
+      </MemoryRouter>,
+    );
+
+    expect(await screen.findByText("[Missing Pic]")).toBeInTheDocument();
+    expect(revokeObjectURLMock).not.toHaveBeenCalled();
+  });
+
+  it("MessageFileCard routes relative/local non-auth links via auth download instead of target=_blank", async () => {
+    mocks.downloadAuthFile.mockResolvedValue(undefined);
+    const openFilePreview = vi.fn();
+
+    render(
+      <MemoryRouter>
+        <ChatFilePreviewProvider
+          openFilePreview={openFilePreview}
+          openKnowledgeCitation={vi.fn()}
+        >
+          <MessageFileCard
+            url="/localoctop/reports/q3.pdf"
+            filename="q3.pdf"
+            agentId="AG1"
+          />
+        </ChatFilePreviewProvider>
+      </MemoryRouter>,
+    );
+
+    // Preview button works for resolved workspace path.
+    fireEvent.click(screen.getByLabelText("common.preview"));
+    expect(openFilePreview).toHaveBeenCalledWith(
+      "/localoctop/reports/q3.pdf",
+      "AG1",
+    );
+
+    // Download button uses authenticated downloadAuthFile, never target=_blank.
+    fireEvent.click(screen.getByLabelText("common.download"));
+    await waitFor(() => {
+      expect(mocks.downloadAuthFile).toHaveBeenCalledWith(
+        "/api/agents/AG1/workspace/download?path=%2Flocaloctop%2Freports%2Fq3.pdf",
+        { filename: "q3.pdf" },
+      );
+    });
+  });
+
+  it("MessageFileCard does not set target=_blank for same-origin non-auth download URLs", () => {
+    const clickedAnchors: HTMLAnchorElement[] = [];
+    const origClick = HTMLAnchorElement.prototype.click;
+    HTMLAnchorElement.prototype.click = function (this: HTMLAnchorElement) {
+      clickedAnchors.push(this);
+    };
+
+    try {
+      render(
+        <MemoryRouter>
+          <MessageFileCard
+            url="/api/downloads/link/tok999"
+            filename="pack.bin"
+            agentId="AG1"
+          />
+        </MemoryRouter>,
+      );
+
+      fireEvent.click(screen.getByLabelText("common.download"));
+      expect(clickedAnchors).toHaveLength(1);
+      expect(clickedAnchors[0].getAttribute("target")).toBeNull();
+      expect(clickedAnchors[0].download).toBe("pack.bin");
+    } finally {
+      HTMLAnchorElement.prototype.click = origClick;
+    }
+  });
+});
diff --git a/dashboard/src/components/Markdown/ZbsChatLinkAndMedia.tsx b/dashboard/src/components/Markdown/ZbsChatLinkAndMedia.tsx
