+def allowed_models_of(raw: Any) -> list[str] | None:
+    """Allowed model refs (``provider/model``), or ``None`` when unrestricted.
+
+    Accepts a stored JSON string, a policy row, a mapping of policy values, or an
+    already-parsed list. An empty or malformed value means "no restriction",
+    matching the module-wide convention that a missing policy is off.
+    """
+    if isinstance(raw, (list, tuple, set)):
+        items: list[Any] = list(raw)
+    else:
+        if isinstance(raw, Mapping) and "value" not in raw:
+            raw = raw.get(POLICY_ALLOWED_MODELS)
+        text = active_policy_value(raw)
+        if text is None:
+            return None
+        try:
+            parsed = json.loads(text)
+        except (TypeError, ValueError):
+            return None
+        if not isinstance(parsed, list):
+            return None
+        items = list(parsed)
+    cleaned: list[str] = []
+    for item in items:
+        ref = str(item).strip()
+        if ref and ref not in cleaned:
+            cleaned.append(ref)
+    return cleaned or None
+
+
+def normalize_allowed_models(raw: Any) -> list[str] | None:
+    """Canonical allow-list; empty input becomes ``None`` (unrestricted)."""
+    return allowed_models_of(raw)
+
+
+def dump_allowed_models(models: Any) -> str | None:
+    """Serialize an allow-list for storage, or ``None`` to clear the policy."""
+    normalized = normalize_allowed_models(models)
+    if normalized is None:
+        return None
+    return json.dumps(normalized, ensure_ascii=False)
+
+
+def effective_allowed_models(policy_repo: Any, user_id: int) -> list[str] | None:
+    """Allow-list for *user_id*; ``None`` means every enabled model is allowed."""
+    return allowed_models_of(policy_repo.get(user_id, POLICY_ALLOWED_MODELS))
+
