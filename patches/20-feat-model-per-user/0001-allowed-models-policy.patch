+def test_allowed_models_absent_means_unrestricted() -> None:
+    """A missing / empty / malformed value must not restrict anything."""
+    assert allowed_models_of(None) is None
+    assert allowed_models_of("") is None
+    assert allowed_models_of("[]") is None
+    assert allowed_models_of("not-json") is None
+    assert allowed_models_of('{"a": 1}') is None
+    assert normalize_allowed_models([]) is None
+
+
+def test_allowed_models_parses_and_normalizes() -> None:
+    assert allowed_models_of('["openai/gpt-4o"]') == ["openai/gpt-4o"]
+    # Trimmed, de-duplicated, order preserved.
+    assert allowed_models_of([" a/b ", "a/b", "c/d"]) == ["a/b", "c/d"]
+    assert normalize_allowed_models('["a/b"]') == ["a/b"]
+    assert dump_allowed_models(["a/b", "c/d"]) == '["a/b", "c/d"]'
+    assert dump_allowed_models([]) is None
+    assert dump_allowed_models(None) is None
+    # Round-trip through storage.
+    assert allowed_models_of(dump_allowed_models(["x/y"])) == ["x/y"]
+
+
+def test_allowed_models_respects_enabled_flag(db: SqlitePool) -> None:
+    users = UserRepo(db)
+    uid = users.create(username="dana", password_hash="h", role="user")
+    policies = UserPolicyRepo(db)
+    assert effective_allowed_models(policies, uid) is None
+
+    policies.merge(uid, {POLICY_ALLOWED_MODELS: dump_allowed_models(["a/b"])})
+    assert effective_allowed_models(policies, uid) == ["a/b"]
+
+    # Clearing the policy restores "unrestricted" (row disabled, not deleted).
+    policies.merge(uid, {POLICY_ALLOWED_MODELS: None})
+    assert effective_allowed_models(policies, uid) is None
+
